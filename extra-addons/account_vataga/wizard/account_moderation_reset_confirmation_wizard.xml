<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_moderation_reset_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">account.moderation.reset.confirmation.wizard.form</field>
        <field name="model">account.moderation.reset.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Підтвердження">
                <group>
                    <p>
                        Ви впевнені, що хочете перейти в чернетку?
                        Кнопки модерації будуть скинуті.
                    </p>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Так, перейти в чернетку" class="btn-primary"/>
                    <button special="cancel" string="Скасувати" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
