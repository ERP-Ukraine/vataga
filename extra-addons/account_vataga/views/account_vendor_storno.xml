<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_vendor_storno" model="ir.ui.view">
        <field name="name">account.move.form.vendor.storno</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon'][contains(@invisible, &quot;payment_state != 'paid'&quot;)]" position="attributes">
                <attribute name="invisible" add="(move_type == 'in_invoice' and vataga_storno_payment_display == 'storno')" separator=" or "/>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][contains(@invisible, &quot;payment_state != 'paid'&quot;)]" position="after">
                <field name="vataga_storno_payment_display" invisible="1"/>
                <widget name="web_ribbon" title="Storno completed" bg_color="text-bg-success"
                        invisible="move_type != 'in_invoice' or vataga_storno_payment_display != 'storno'"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="vataga_storno_purchase_ids" invisible="1"/>
                <field name="vataga_storno_bill_id" invisible="move_type != 'in_refund'"
                       options="{'no_create': True}"
                       domain="[('move_type', '=', 'in_invoice'), ('state', '!=', 'cancel'),
                                ('id', '!=', id), ('company_id', '=', company_id),
                                ('commercial_partner_id', '=', commercial_partner_id),
                                ('commercial_partner_id', '!=', False)]
                               + ([('invoice_line_ids.purchase_line_id.order_id', 'in', vataga_storno_purchase_ids)]
                                  if vataga_storno_purchase_ids else [])"/>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_vendor_storno" model="ir.ui.view">
        <field name="name">account.move.vendor.bill.tree.storno</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <field name="payment_state" position="replace">
                <field name="payment_state" column_invisible="True"/>
                <field name="vataga_storno_payment_display" string="Payment" widget="badge"
                       decoration-danger="vataga_storno_payment_display == 'not_paid'"
                       decoration-warning="vataga_storno_payment_display in ('partial', 'in_payment')"
                       decoration-success="vataga_storno_payment_display in ('paid', 'reversed', 'storno')"
                       invisible="payment_state == 'invoicing_legacy' or state != 'posted' or move_type == 'entry'"
                       optional="show"/>
            </field>
        </field>
    </record>
</odoo>
