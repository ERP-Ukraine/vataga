<templates>
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter-topbar')]//span[hasclass('o-mail-Chatter-topbarGrow')]" position="before">
            <button
                t-if="showAccountMoveAutologToggle"
                type="button"
                class="o-mail-Chatter-accountMoveAutologToggle btn text-nowrap mx-1 px-2"
                t-att-class="{
                    'btn-secondary': accountMoveAutologsEnabled,
                    'btn-outline-secondary': !accountMoveAutologsEnabled,
                    'my-2': !props.compactHeight,
                }"
                t-att-title="accountMoveAutologButtonLabel"
                t-att-aria-label="accountMoveAutologButtonLabel"
                t-on-click="toggleAccountMoveAutologs"
            >
                <i class="me-1" t-att-class="accountMoveAutologButtonIconClass"/>
                <span t-out="accountMoveAutologButtonLabel"/>
            </button>
        </xpath>
    </t>
</templates>
