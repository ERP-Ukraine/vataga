<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="product_alternatives_vataga.ProductAnalogMarkerField">
        <div class="o_product_analog_marker" t-if="marker" t-ref="root">
            <button
                type="button"
                class="btn btn-link o_product_analog_marker_button"
                t-on-click="toggleDropdown"
            >
                <t t-esc="marker"/>
            </button>
            <div
                t-if="state.open"
                class="o_product_analog_marker_menu"
                t-att-style="state.menuStyle"
            >
                <table class="o_product_analog_marker_table">
                    <thead>
                        <tr>
                            <th>Товар специфікації</th>
                            <th>Аналог</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr
                            t-foreach="analogRows"
                            t-as="analogRow"
                            t-key="analogRow.component + '|' + analogRow.analog"
                        >
                            <td>
                                <t t-esc="analogRow.component"/>
                            </td>
                            <td>
                                <t t-esc="analogRow.analog"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>
