<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="product_alternatives_vataga.ProductAnalogMarkerField">
        <div
            class="o_product_analog_marker"
            t-if="marker"
            t-ref="root"
            t-on-mouseenter="clearTitles"
            t-on-focusin="clearTitles"
        >
            <button
                type="button"
                class="btn btn-link o_product_analog_marker_button"
                title=""
                t-on-click="toggleDropdown"
            >
                <t t-esc="marker"/>
            </button>
            <div
                t-if="state.open and analogRows.length"
                class="o_product_analog_marker_menu"
                t-att-style="state.menuStyle"
            >
                <table class="o_product_analog_marker_table">
                    <thead>
                        <tr>
                            <th>&#1058;&#1086;&#1074;&#1072;&#1088;</th>
                            <th>&#1040;&#1085;&#1072;&#1083;&#1086;&#1075;</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr
                            t-foreach="analogRows"
                            t-as="analogRow"
                            t-key="analogRow.component + '|' + analogRow.analog"
                        >
                            <td>
                                <t t-esc="analogRow.component"/>
                            </td>
                            <td>
                                <t t-esc="analogRow.analog"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>
