<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_analog_rollup_diagnostic" model="ir.cron">
            <field name="name">Діагностика аналітики аналогів (ручний запуск)</field>
            <field name="active" eval="False"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="sale_demand_vataga.model_product_analytic"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
result = model._run_analog_rollup_diagnostic(
    product_codes=["RES-BEC-0113", "RES-BEC-0114"],
    contract_references=["SE-10417"],
    all_contracts=False,
    date_from=None,
    date_to=None,
    watch_quantities=[2440, 1760, 444, 200, 244],
)
for message in result["log_messages"]:
    log(message, level="warning")
            ]]></field>
        </record>
    </data>
</odoo>
