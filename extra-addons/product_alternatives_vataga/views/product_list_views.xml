<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_view_analog_list_marker" model="ir.ui.view">
        <field name="name">product.template.tree.analog.list.marker</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='name']" position="after">
                <field name="analog_list_marker" string="Аналоги" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view_analog_list_marker" model="ir.ui.view">
        <field name="name">product.product.tree.analog.list.marker</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='name']" position="after">
                <field name="analog_list_marker" string="Аналоги" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
