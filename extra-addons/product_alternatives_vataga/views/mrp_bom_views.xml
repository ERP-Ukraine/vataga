<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_analogs" model="ir.ui.view">
        <field name="name">mrp.bom.form.analogs</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']//field[@name='product_id']" position="after">
                <field name="analog_product_names" invisible="1"/>
                <field
                    name="analog_marker"
                    string="Аналоги"
                    widget="product_analog_marker"
                    readonly="1"
                    optional="show"
                />
            </xpath>
        </field>
    </record>
</odoo>
