<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_analogs" model="ir.ui.view">
        <field name="name">mrp.bom.form.analogs</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']//field[@name='product_id']" position="after">
                <field name="analog_product_names" invisible="1"/>
                <field
                    name="analog_marker"
                    string="&#1040;&#1085;&#1072;&#1083;&#1086;&#1075;&#1080;"
                    widget="product_analog_marker"
                    readonly="1"
                    optional="show"
                />
            </xpath>
        </field>
    </record>

    <record id="mrp_bom_tree_view_analogs" model="ir.ui.view">
        <field name="name">mrp.bom.tree.analogs</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='product_tmpl_id' and not(@invisible='1')]" position="after">
                <field
                    name="analog_marker"
                    string="&#1040;&#1085;&#1072;&#1083;&#1086;&#1075;&#1080;"
                    widget="product_analog_marker"
                    readonly="1"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>
</odoo>
