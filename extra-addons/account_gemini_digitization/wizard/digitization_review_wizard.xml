<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_gemini_digitization_review_wizard_form" model="ir.ui.view">
        <field name="name">account.gemini.digitization.review.wizard.form</field>
        <field name="model">account.gemini.digitization.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Gemini Digitization">
                <sheet>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="mode"/>
                            <field name="move_id" invisible="mode == 'full_purchase'"/>
                            <field name="purchase_order_id" invisible="mode != 'full_purchase'"/>
                            <field name="partner_id"/>
                            <field name="attachment_id"/>
                            <field name="recognized_invoice_number"/>
                            <field name="recognized_invoice_date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="confidence"/>
                            <field name="recognized_amount_untaxed"/>
                            <field name="recognized_amount_tax"/>
                            <field name="recognized_amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="apply_action"/>
                                    <field
                                        name="merge_target_line_id"
                                        domain="[('wizard_id', '=', parent.id), ('apply_action', '=', 'create_line')]"
                                    />
                                    <field name="matched_product_id"/>
                                    <field name="match_status" readonly="1"/>
                                    <field name="match_score" readonly="1"/>
                                    <field name="match_summary" readonly="1"/>
                                    <field name="match_method" readonly="1"/>
                                    <field
                                        name="move_line_id"
                                        domain="[('move_id', '=', parent.move_id), ('product_id', '!=', False)]"
                                        readonly="parent.mode == 'full_bill'"
                                        column_invisible="parent.mode == 'full_purchase'"
                                    />
                                    <field name="supplier_product_code"/>
                                    <field name="supplier_product_name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_rate"/>
                                    <field
                                        name="tax_ids"
                                        widget="many2many_tags"
                                        domain="[('active', '=', True), ('amount_type', '=', 'percent'), ('type_tax_use', 'in', ('purchase', 'none'))]"
                                    />
                                    <field name="amount_untaxed" readonly="1"/>
                                    <field name="amount_tax" readonly="1"/>
                                    <field name="amount_total" readonly="1"/>
                                    <field name="line_subtotal_without_tax" readonly="1"/>
                                    <field name="line_tax_amount" readonly="1"/>
                                    <field name="line_total_with_tax" readonly="1"/>
                                    <field name="price_unit_without_tax" readonly="1"/>
                                    <field name="price_unit_with_tax" readonly="1"/>
                                    <field name="uom_name"/>
                                    <field name="description"/>
                                    <field name="candidate_product_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="candidate_move_line_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="confidence"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="apply_action"/>
                                            <field
                                                name="merge_target_line_id"
                                                domain="[('wizard_id', '=', parent.id), ('apply_action', '=', 'create_line')]"
                                            />
                                            <field
                                                name="move_line_id"
                                                domain="[('move_id', '=', parent.move_id), ('product_id', '!=', False)]"
                                                readonly="parent.mode == 'full_bill'"
                                                invisible="parent.mode == 'full_purchase'"
                                            />
                                            <field name="matched_product_id"/>
                                            <field name="match_status" readonly="1"/>
                                            <field name="match_score" readonly="1"/>
                                            <field name="match_method" readonly="1"/>
                                            <field name="match_summary" readonly="1"/>
                                            <field name="supplier_product_code" readonly="1"/>
                                            <field name="supplier_product_name" readonly="parent.mode == 'partial_bill'"/>
                                            <field name="description" readonly="parent.mode == 'partial_bill'"/>
                                            <field name="quantity" readonly="parent.mode == 'partial_bill'"/>
                                            <field name="uom_name" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="price_unit_without_tax" readonly="1"/>
                                            <field name="price_unit_with_tax" readonly="1"/>
                                            <field name="price_unit"/>
                                            <field name="tax_rate"/>
                                            <field
                                                name="tax_ids"
                                                widget="many2many_tags"
                                                domain="[('active', '=', True), ('amount_type', '=', 'percent'), ('type_tax_use', 'in', ('purchase', 'none'))]"
                                            />
                                            <field name="line_subtotal_without_tax" readonly="1"/>
                                            <field name="line_tax_amount" readonly="1"/>
                                            <field name="line_total_with_tax" readonly="1"/>
                                            <field name="amount_untaxed" readonly="1"/>
                                            <field name="amount_tax" readonly="1"/>
                                            <field name="amount_total" readonly="1"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                    <group string="Matching">
                                        <field name="candidate_product_ids" widget="many2many_tags" readonly="1"/>
                                        <field name="candidate_move_line_ids" widget="many2many_tags" readonly="1"/>
                                        <field name="match_note" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="source_columns" readonly="1"/>
                                        <field name="note" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        name="action_close"
                        string="Close"
                        type="object"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
