<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_gemini_digitization_review_wizard_form" model="ir.ui.view">
        <field name="name">account.gemini.digitization.review.wizard.form</field>
        <field name="model">account.gemini.digitization.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Gemini Digitization">
                <sheet>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="mode"/>
                            <field name="recognized_invoice_number"/>
                            <field name="recognized_invoice_date"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="recognized_amount_untaxed"/>
                            <field name="recognized_amount_tax"/>
                            <field name="recognized_amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="supplier_product_code"/>
                                    <field name="supplier_product_name"/>
                                    <field name="description"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_name"/>
                                    <field name="price_unit"/>
                                    <field name="tax_rate"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="confidence"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        name="action_close"
                        string="Close"
                        type="object"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
