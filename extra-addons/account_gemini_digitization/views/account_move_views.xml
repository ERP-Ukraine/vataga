<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_gemini_digitization" model="ir.ui.view">
        <field name="name">account.move.form.gemini.digitization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_create_gemini_digitization_job"
                    string="Оцифрувати через Gemini"
                    type="object"
                    class="oe_highlight"
                    invisible="move_type != 'in_invoice' or state != 'draft'"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_gemini_digitization_jobs"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-magic"
                    invisible="gemini_digitization_job_count == 0"
                >
                    <field
                        name="gemini_digitization_job_count"
                        widget="statinfo"
                        string="Gemini OCR"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
