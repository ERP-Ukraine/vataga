<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_gemini_digitization" model="ir.ui.view">
        <field name="name">purchase.order.form.gemini.digitization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_create_gemini_digitization_job"
                    string="Оцифрувати через Gemini"
                    type="object"
                    class="oe_highlight"
                    invisible="state not in ('draft', 'sent')"
                />
            </xpath>
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Gemini OCR" name="gemini_ocr">
                    <group string="Файл для Gemini OCR">
                        <field
                            name="gemini_attachment_ids"
                            widget="many2many_binary"
                            options="{'accepted_file_extensions': '.pdf,.png,.jpg,.jpeg'}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
