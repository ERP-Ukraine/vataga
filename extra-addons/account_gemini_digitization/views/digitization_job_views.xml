<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_gemini_digitization_job_tree" model="ir.ui.view">
        <field name="name">account.gemini.digitization.job.tree</field>
        <field name="model">account.gemini.digitization.job</field>
        <field name="arch" type="xml">
            <tree string="Gemini Digitization Jobs">
                <field name="name"/>
                <field name="state"/>
                <field name="mode"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="purchase_order_id"/>
                <field name="recognized_invoice_number"/>
                <field name="recognized_invoice_date"/>
                <field name="recognized_amount_total"/>
                <field name="confidence"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_account_gemini_digitization_job_form" model="ir.ui.view">
        <field name="name">account.gemini.digitization.job.form</field>
        <field name="model">account.gemini.digitization.job</field>
        <field name="arch" type="xml">
            <form string="Gemini Digitization Job">
                <header>
                    <button
                        name="action_process"
                        string="Process"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ('draft', 'error')"
                    />
                    <button
                        name="action_open_review_wizard"
                        string="Open Review"
                        type="object"
                        invisible="state != 'review'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state in ('done', 'cancelled')"
                    />
                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state not in ('error', 'cancelled')"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,processing,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="mode"/>
                            <field name="move_id"/>
                            <field name="purchase_order_id"/>
                            <field name="partner_id"/>
                            <field name="attachment_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="confidence"/>
                        </group>
                    </group>
                    <group string="Recognized Header">
                        <field name="recognized_invoice_number"/>
                        <field name="recognized_invoice_date"/>
                        <field name="recognized_amount_untaxed"/>
                        <field name="recognized_amount_tax"/>
                        <field name="recognized_amount_total"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" context="{'default_job_id': id}">
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="supplier_product_code"/>
                                    <field name="supplier_product_name"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_name"/>
                                    <field name="price_unit_without_tax"/>
                                    <field name="price_unit_with_tax"/>
                                    <field name="price_unit"/>
                                    <field name="tax_rate"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="line_subtotal_without_tax"/>
                                    <field name="line_tax_amount"/>
                                    <field name="line_total_with_tax"/>
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_total"/>
                                    <field name="source_columns"/>
                                    <field name="matched_product_id"/>
                                    <field name="match_status"/>
                                    <field name="match_score"/>
                                    <field name="match_method"/>
                                    <field name="move_line_id"/>
                                    <field name="confidence"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="supplier_product_code"/>
                                            <field name="supplier_product_name"/>
                                            <field name="description"/>
                                            <field name="quantity"/>
                                            <field name="uom_name"/>
                                            <field name="price_unit_without_tax"/>
                                            <field name="price_unit_with_tax"/>
                                            <field name="price_unit"/>
                                            <field name="tax_rate"/>
                                            <field name="tax_ids" widget="many2many_tags"/>
                                        </group>
                                        <group>
                                            <field name="line_subtotal_without_tax"/>
                                            <field name="line_tax_amount"/>
                                            <field name="line_total_with_tax"/>
                                            <field name="amount_untaxed"/>
                                            <field name="amount_tax"/>
                                            <field name="amount_total"/>
                                            <field name="matched_product_id"/>
                                            <field name="match_status"/>
                                            <field name="match_score"/>
                                            <field name="match_method"/>
                                            <field name="move_line_id"/>
                                            <field name="confidence"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="source_columns"/>
                                        <field name="note"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Raw JSON">
                            <group>
                                <field name="raw_request_json_text" readonly="1"/>
                                <field name="raw_response_json_text" readonly="1"/>
                            </group>
                        </page>
                        <page string="Errors">
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_gemini_digitization_job_search" model="ir.ui.view">
        <field name="name">account.gemini.digitization.job.search</field>
        <field name="model">account.gemini.digitization.job</field>
        <field name="arch" type="xml">
            <search string="Gemini Digitization Jobs">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="purchase_order_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="review" string="Review" domain="[('state', '=', 'review')]"/>
                <filter name="error" string="Error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_mode" string="Mode" context="{'group_by': 'mode'}"/>
                    <filter name="group_by_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_gemini_digitization_job" model="ir.actions.act_window">
        <field name="name">Gemini Digitization Jobs</field>
        <field name="res_model">account.gemini.digitization.job</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_account_gemini_digitization_job_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Gemini digitization job.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_account_gemini_digitization_root"
        name="Gemini Digitization"
        parent="account.menu_finance_configuration"
        sequence="80"
        groups="account.group_account_manager"
    />

    <menuitem
        id="menu_account_gemini_digitization_jobs"
        name="Digitization Jobs"
        parent="menu_account_gemini_digitization_root"
        action="action_account_gemini_digitization_job"
        sequence="10"
        groups="account.group_account_manager"
    />
</odoo>
