<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_gemini_digitization_job_tree" model="ir.ui.view">
        <field name="name">account.gemini.digitization.job.tree</field>
        <field name="model">account.gemini.digitization.job</field>
        <field name="arch" type="xml">
            <tree string="Gemini Digitization Jobs">
                <field name="name"/>
                <field name="state"/>
                <field name="mode"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="purchase_order_id"/>
                <field name="recognized_invoice_number"/>
                <field name="recognized_invoice_date"/>
                <field name="recognized_amount_total"/>
                <field name="confidence"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_account_gemini_digitization_job_form" model="ir.ui.view">
        <field name="name">account.gemini.digitization.job.form</field>
        <field name="model">account.gemini.digitization.job</field>
        <field name="arch" type="xml">
            <form string="Gemini Digitization Job" class="o_gemini_digitization_job_form">
                <header>
                    <button
                        name="action_process"
                        string="Process"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_run_matching"
                        string="Re-run Matching"
                        type="object"
                        invisible="state != 'review'"
                    />
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'review'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state not in ('draft', 'processing', 'review')"
                    />
                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state not in ('error', 'cancelled')"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,processing,review,done"/>
                </header>
                <sheet class="o_gemini_digitization_sheet">
                    <field name="attachment_name" invisible="1"/>
                    <field name="attachment_mimetype" invisible="1"/>
                    <field name="attachment_is_pdf" invisible="1"/>
                    <field name="attachment_is_image" invisible="1"/>
                    <field name="attachment_preview_supported" invisible="1"/>
                    <div class="o_gemini_job_workspace">
                        <div class="o_gemini_job_details">
                            <div class="oe_title">
                                <label for="name"/>
                                <h1>
                                    <field name="name"/>
                                </h1>
                            </div>
                            <group>
                                <group>
                                    <field name="mode"/>
                                    <field name="move_id"/>
                                    <field name="purchase_order_id"/>
                                    <field name="partner_id"/>
                                    <field name="attachment_id"/>
                                </group>
                                <group>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="currency_id"/>
                                    <field name="res_model" readonly="1"/>
                                    <field name="res_id" readonly="1"/>
                                    <field name="confidence"/>
                                </group>
                            </group>
                            <group string="Recognized Header">
                                <field name="recognized_invoice_number"/>
                                <field name="recognized_invoice_date"/>
                                <field name="recognized_amount_untaxed"/>
                                <field name="recognized_amount_tax"/>
                                <field name="recognized_amount_total"/>
                            </group>
                        </div>
                        <div class="o_gemini_document_panel">
                            <div class="o_gemini_document_header">
                                <h2>Document Preview</h2>
                                <button
                                    name="action_open_source_attachment"
                                    string="Open Document in New Tab"
                                    type="object"
                                    class="btn btn-secondary"
                                    icon="fa-external-link"
                                    invisible="not attachment_id"
                                />
                            </div>
                            <div class="o_gemini_document_filename" invisible="not attachment_id">
                                <span>File:</span>
                                <field name="attachment_name" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_gemini_document_preview">
                                <field
                                    name="attachment_preview_data"
                                    widget="pdf_viewer"
                                    filename="attachment_name"
                                    nolabel="1"
                                    readonly="1"
                                    invisible="not attachment_is_pdf"
                                />
                                <field
                                    name="attachment_preview_data"
                                    widget="image"
                                    filename="attachment_name"
                                    class="o_gemini_preview_image"
                                    nolabel="1"
                                    readonly="1"
                                    invisible="not attachment_is_image"
                                />
                                <div
                                    class="o_gemini_preview_message text-muted"
                                    invisible="attachment_id"
                                >
                                    Document for preview has not been uploaded.
                                </div>
                                <div
                                    class="o_gemini_preview_message text-muted"
                                    invisible="not attachment_id or attachment_preview_supported"
                                >
                                    Preview is available only for PDF files and images.
                                </div>
                            </div>
                        </div>
                    </div>
                    <notebook>
                        <page string="Recognition Lines">
                            <field
                                name="line_ids"
                                context="{'default_job_id': id}"
                                readonly="state != 'review'"
                            >
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle" optional="hide"/>
                                    <field name="apply_action"/>
                                    <field
                                        name="merge_target_line_id"
                                        domain="[('job_id', '=', parent.id), ('apply_action', '=', 'create_line')]"
                                    />
                                    <field name="supplier_product_code" readonly="1"/>
                                    <field name="supplier_product_name" readonly="1"/>
                                    <field name="matched_product_id"/>
                                    <field
                                        name="move_line_id"
                                        domain="[('move_id', '=', parent.move_id), ('product_id', '!=', False)]"
                                        column_invisible="parent.mode != 'partial_bill'"
                                    />
                                    <field name="match_status" readonly="1"/>
                                    <field name="match_score" readonly="1"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" string="Price Without Tax"/>
                                    <field name="tax_rate"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="line_subtotal_without_tax" readonly="1"/>
                                    <field name="line_total_with_tax" readonly="1"/>
                                    <field name="match_summary" readonly="1"/>
                                    <field name="description" readonly="1" optional="hide"/>
                                    <field name="uom_name" readonly="1" optional="hide"/>
                                    <field name="price_unit_without_tax" readonly="1" optional="hide"/>
                                    <field name="price_unit_with_tax" readonly="1" optional="hide"/>
                                    <field name="line_tax_amount" readonly="1" optional="hide"/>
                                    <field name="amount_untaxed" readonly="1" optional="hide"/>
                                    <field name="amount_tax" readonly="1" optional="hide"/>
                                    <field name="amount_total" readonly="1" optional="hide"/>
                                    <field name="source_columns" readonly="1" optional="hide"/>
                                    <field name="candidate_product_ids" widget="many2many_tags" readonly="1" optional="hide"/>
                                    <field name="match_method" readonly="1" optional="hide"/>
                                    <field name="purchase_order_line_id" readonly="1" optional="hide"/>
                                    <field name="candidate_move_line_ids" widget="many2many_tags" readonly="1" optional="hide"/>
                                    <field name="confidence" readonly="1" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="sequence" readonly="1"/>
                                            <field name="apply_action"/>
                                            <field
                                                name="merge_target_line_id"
                                                domain="[('job_id', '=', parent.id), ('apply_action', '=', 'create_line')]"
                                            />
                                            <field name="supplier_product_code" readonly="1"/>
                                            <field name="supplier_product_name" readonly="1"/>
                                            <field name="description" readonly="1"/>
                                            <field name="quantity"/>
                                            <field name="uom_name" readonly="1"/>
                                            <field name="price_unit_without_tax" readonly="1"/>
                                            <field name="price_unit_with_tax" readonly="1"/>
                                            <field name="price_unit"/>
                                            <field name="tax_rate"/>
                                            <field name="tax_ids" widget="many2many_tags"/>
                                        </group>
                                        <group>
                                            <field name="line_subtotal_without_tax" readonly="1"/>
                                            <field name="line_tax_amount" readonly="1"/>
                                            <field name="line_total_with_tax" readonly="1"/>
                                            <field name="amount_untaxed" readonly="1"/>
                                            <field name="amount_tax" readonly="1"/>
                                            <field name="amount_total" readonly="1"/>
                                            <field name="matched_product_id"/>
                                            <field name="candidate_product_ids" widget="many2many_tags" readonly="1"/>
                                            <field name="match_status" readonly="1"/>
                                            <field name="match_score" readonly="1"/>
                                            <field name="match_method" readonly="1"/>
                                            <field name="match_summary" readonly="1"/>
                                            <field
                                                name="move_line_id"
                                                domain="[('move_id', '=', parent.move_id), ('product_id', '!=', False)]"
                                                invisible="parent.mode != 'partial_bill'"
                                            />
                                            <field name="purchase_order_line_id" readonly="1"/>
                                            <field name="candidate_move_line_ids" widget="many2many_tags" readonly="1"/>
                                            <field name="confidence" readonly="1"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="source_columns" readonly="1"/>
                                        <field name="note" readonly="1"/>
                                    </group>
                                    <group string="Matching Diagnostics">
                                        <field name="match_note" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Raw JSON">
                            <group>
                                <field name="raw_request_json_text" readonly="1"/>
                                <field name="raw_response_json_text" readonly="1"/>
                            </group>
                        </page>
                        <page string="Errors and Warnings">
                            <field name="matching_message"/>
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_gemini_digitization_job_search" model="ir.ui.view">
        <field name="name">account.gemini.digitization.job.search</field>
        <field name="model">account.gemini.digitization.job</field>
        <field name="arch" type="xml">
            <search string="Gemini Digitization Jobs">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="purchase_order_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="review" string="Review" domain="[('state', '=', 'review')]"/>
                <filter name="error" string="Error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_mode" string="Mode" context="{'group_by': 'mode'}"/>
                    <filter name="group_by_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_gemini_digitization_job" model="ir.actions.act_window">
        <field name="name">Gemini Digitization Jobs</field>
        <field name="res_model">account.gemini.digitization.job</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_account_gemini_digitization_job_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Gemini digitization job.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_account_gemini_digitization_root"
        name="Gemini Digitization"
        parent="account.menu_finance"
        sequence="80"
        groups="base.group_user"
    />

    <menuitem
        id="menu_account_gemini_digitization_jobs"
        name="Digitization Jobs"
        parent="menu_account_gemini_digitization_root"
        action="action_account_gemini_digitization_job"
        sequence="10"
        groups="base.group_user"
    />
</odoo>
