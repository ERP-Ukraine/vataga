<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <delete
        model="ir.ui.menu"
        search="[('name', 'in', ['Gemini Digitization Jobs', 'Завдання оцифрування Gemini'])]"
    />
    <delete
        model="ir.ui.menu"
        search="[('name', 'in', ['Gemini Digitization', 'Оцифрування Gemini'])]"
    />
    <delete
        model="ir.actions.act_window"
        search="[('res_model', '=', 'account.gemini.digitization.job')]"
    />
    <delete
        model="ir.ui.view"
        search="[('model', '=', 'account.gemini.digitization.job')]"
    />
    <record id="view_gemini_staging_diagnostic_form" model="ir.ui.view">
        <field name="name">Gemini staging diagnostic</field>
        <field name="model">account.gemini.digitization.job</field>
        <field name="arch" type="xml">
            <form string="Gemini staging diagnostic" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name"/><field name="state"/><field name="mode"/>
                        <field name="move_id"/><field name="purchase_order_id"/>
                        <field name="attachment_id"/><field name="error_message"/>
                    </group>
                    <notebook><page string="Raw JSON">
                        <field name="raw_request_json_text"/>
                        <field name="raw_response_json_text"/>
                    </page></notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
