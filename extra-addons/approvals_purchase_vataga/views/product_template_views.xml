<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_purchase_url" model="ir.ui.view">
        <field name="name">product.template.vataga.purchase.url</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="inside">
                <group>
                    <field name="vataga_purchase_url" widget="vataga_purchase_url"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
