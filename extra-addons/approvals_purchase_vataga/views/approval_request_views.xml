<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_request_vataga_purchase" model="ir.ui.view">
        <field name="name">approval.request.vataga.purchase.form</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals_purchase.approval_purchase_request_view_form_inherit"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="vataga_can_create_rfq" invisible="1"/>
                <field name="vataga_lines_locked" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='request_owner_id']" position="attributes">
                <attribute name="readonly" add="approval_type == 'purchase'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="readonly" add="vataga_lines_locked" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly" add="vataga_lines_locked" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='reference']" position="attributes">
                <attribute name="readonly" add="vataga_lines_locked" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="string">Дата початку</attribute>
                <attribute name="readonly" add="vataga_lines_locked" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="attributes">
                <attribute name="string">Дата закінчення</attribute>
                <attribute name="readonly" add="vataga_lines_locked" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='request_owner_id']" position="after">
                <field name="vataga_display_number" invisible="approval_type != 'purchase'" readonly="1"/>
                <field name="vataga_purchase_subject" invisible="approval_type != 'purchase' or not automated_sequence"
                       readonly="vataga_lines_locked" placeholder="Коротко опишіть потребу в закупівлі"/>
            </xpath>
            <xpath expr="//field[@name='product_line_ids']" position="attributes">
                <attribute name="readonly" add="vataga_lines_locked" separator=" or "/>
            </xpath>
            <xpath expr="//page[@name='products']" position="attributes">
                <attribute name="invisible">approval_type != 'purchase' and has_product == 'no'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_create_purchase_orders']" position="attributes">
                <attribute name="string">Створити ЗНКП</attribute>
                <attribute name="invisible">not vataga_can_create_rfq</attribute>
            </xpath>
            <xpath expr="//group[@name='request_details']" position="inside">
                <field name="vataga_rfq_block_reason" readonly="1" nolabel="1"
                       invisible="approval_type != 'purchase' or vataga_can_create_rfq"/>
            </xpath>
        </field>
    </record>
    <record id="view_approval_request_vataga_late_period_ui" model="ir.ui.view">
        <field name="name">approval.request.vataga.late.period.ui</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <!-- ERP-UA adds another period pair after the purchase branch.
                 Odoo inheritance changes only the first XPath match, so target
                 the final pair explicitly after the other root extensions. -->
            <xpath expr="(//field[@name='date_start'])[last()]" position="attributes">
                <attribute name="string">Дата початку</attribute>
                <attribute name="readonly" add="vataga_lines_locked" separator=" or "/>
            </xpath>
            <xpath expr="(//field[@name='date_end'])[last()]" position="attributes">
                <attribute name="string">Дата закінчення</attribute>
                <attribute name="readonly" add="vataga_lines_locked" separator=" or "/>
            </xpath>
        </field>
    </record>
    <record id="view_approval_product_line_vataga_purchase" model="ir.ui.view">
        <field name="name">approval.product.line.vataga.purchase.tree</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals.approval_product_line_view_tree"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="required">parent.approval_type != 'purchase'</attribute>
            </xpath>
            <xpath expr="//field[@name='description']" position="after">
                <field name="vataga_product_url" widget="vataga_purchase_url" column_invisible="parent.approval_type != 'purchase'"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="column_invisible">parent.approval_type != 'purchase' and parent.has_quantity == 'no'</attribute>
            </xpath>
            <xpath expr="//tree" position="inside">
                <field name="vataga_can_resolve" column_invisible="True"/>
                <field name="vataga_filled_after_approval" column_invisible="parent.approval_type != 'purchase'" optional="hide"/>
                <field name="vataga_product_created_from_request" column_invisible="parent.approval_type != 'purchase'" optional="hide"/>
                <button name="action_vataga_resolve" type="object" string="Заповнити товар" icon="fa-pencil-square-o"
                        groups="purchase.group_purchase_user" invisible="not vataga_can_resolve"
                        column_invisible="parent.approval_type != 'purchase'"/>
            </xpath>
        </field>
    </record>
    <record id="view_approval_product_line_vataga_mobile" model="ir.ui.view">
        <field name="name">approval.product.line.vataga.purchase.mobile</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals.approval_product_kanban_mobile_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="description"/>
                <field name="vataga_product_url"/>
                <field name="vataga_approval_type"/>
                <field name="vataga_can_resolve"/>
            </xpath>
            <xpath expr="//t[@t-name='kanban-box']/div" position="inside">
                <div t-if="record.vataga_approval_type.raw_value == 'purchase'">
                    <div><field name="description"/></div>
                    <div><field name="vataga_product_url" widget="vataga_purchase_url"/></div>
                    <button name="action_vataga_resolve" type="object" class="btn btn-link"
                            t-if="record.vataga_can_resolve.raw_value" groups="purchase.group_purchase_user">
                        Заповнити товар
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
