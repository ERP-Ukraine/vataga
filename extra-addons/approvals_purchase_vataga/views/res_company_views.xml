<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_vataga_supplier" model="ir.ui.view">
        <field name="name">res.company.vataga.supplier.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Закупочні заявки Vataga" name="vataga_purchase">
                    <group><field name="vataga_default_supplier_id" options="{'no_create': True}"/></group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
