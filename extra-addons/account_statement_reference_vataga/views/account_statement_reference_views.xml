<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_statement_line_tree_bank_rec_widget_vataga" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.bank.rec.widget.vataga</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_tree_bank_rec_widget"/>
        <field name="arch" type="xml">
            <field name="payment_ref" position="after">
                <field name="linked_payment_ref" optional="show"/>
                <field name="linked_invoice_ref" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_bank_statement_line_kanban_bank_rec_widget_vataga" model="ir.ui.view">
        <field name="name">account.bank.statement.line.kanban.bank.rec.widget.vataga</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_kanban_bank_rec_widget"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='row2_col1']/.." position="after">
                <div class="flex_row">
                    <div id="row3_col1">
                        <span class="text-muted">Референс платежу</span>
                        <div>
                            <field name="linked_payment_ref"/>
                        </div>
                    </div>
                    <div id="row3_col2">
                        <span class="text-muted">Референс рахунку</span>
                        <div>
                            <field name="linked_invoice_ref"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_form_statement_reference_vataga" model="ir.ui.view">
        <field name="name">account.move.line.form.statement.reference.vataga</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_accounting_documents']//field[@name='statement_line_id']" position="after">
                <field name="statement_payment_ref" readonly="1"/>
                <field name="statement_invoice_ref" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
