<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t
        t-name="account_statement_reference_vataga.bank_rec_form"
        t-inherit="account_accountant.bank_rec_form"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('grid')]/div[@name='name']" position="after">
