<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_search_view_packaging_barcode" model="ir.ui.view">
            <field name="name">product.template.search.packaging.barcode</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="filter_domain">['|', '|', '|', '|', ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self), ('product_variant_ids.packaging_ids.barcode', 'ilike', self)]</attribute>
                </xpath>
            </field>
        </record>

        <record id="product_product_search_view_packaging_barcode" model="ir.ui.view">
            <field name="name">product.product.search.packaging.barcode</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_search_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="filter_domain">['|', '|', '|', ('default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self), ('packaging_ids.barcode', 'ilike', self)]</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
