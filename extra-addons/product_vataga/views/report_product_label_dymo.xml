<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template
            id="report_simple_label_dymo"
            name="Dymo label without price"
            inherit_id="product.report_simple_label_dymo"
            priority="99"
        >
            <xpath expr="//div[contains(@class, 'o_label_full')]" position="replace">
                <div
                    class="o_label_full"
                    t-att-style="(table_style or '') + ';border-radius: 22px; background-color: #fff; padding: 10px 14px 8px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; min-height: 100%;'"
                >
                    <div class="text-center" style="width: 100%;">
                        <t t-if="barcode">
                            <div
                                t-out="barcode"
                                style="padding:0; width: 100%;"
                                t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:100%;height:38px;'}"
                            />
                            <div
                                style="background-color: transparent; font-size: 10px; font-weight: 700; line-height: 1; text-align: center; margin-top: 2px;"
                            >
                                <span t-out="barcode"/>
                            </div>
                        </t>
                    </div>
                    <div
                        style="flex: 1 1 auto; display: flex; align-items: center; justify-content: center; text-align: center; padding: 8px 2px 4px;"
                    >
                        <div
                            class="o_label_name"
                            style="line-height: 1.15; background-color: transparent; font-size: 11px; font-weight: 700; max-height: 3.6em; overflow: hidden;"
                        >
                            <span t-if="product.is_product_variant" t-field="product.display_name"/>
                            <span t-else="" t-field="product.name"/>
                        </div>
                    </div>
                    <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 10px;">
                        <div style="font-size: 13px; font-weight: 500; line-height: 1; white-space: nowrap;">
                            <span t-field="product.default_code"/>
                        </div>
                        <div
                            t-if="product.uom_id"
                            style="display: flex; align-items: flex-end; gap: 6px; margin-left: auto; white-space: nowrap;"
                        >
                            <span
                                style="display: inline-block; width: 48px; border-bottom: 2px solid #000; transform: translateY(-2px);"
                            />
                            <span style="font-size: 12px; font-weight: 700; line-height: 1;" t-field="product.uom_id.name"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
