<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="report_deliveryslip_actual_quantity"
        inherit_id="l10n_ua_stock_reports.sales_invoice_template"
        priority="100"
    >
        <xpath
            expr="//t[@t-set='lines' and @t-value='o.move_ids.filtered(lambda x: x.product_uom_qty)']"
            position="attributes"
        >
            <attribute name="t-value">
                o.move_ids.filtered(lambda move: move.product_uom_qty or move.quantity)
            </attribute>
        </xpath>

        <xpath
            expr="//table[.//span[@t-field='move.product_uom_qty' or (@t-esc and contains(@t-esc, 'move.product_uom_qty') and not(contains(@t-esc, 'unit_cost')))] and .//*[contains(@t-esc, 'unit_cost') and contains(@t-esc, 'move.product_uom_qty')]]"
            position="before"
        >
            <t t-if="o.picking_type_id.code == 'internal'">
                <style>
                    .page {
                        font-size: 10.5pt !important;
                        line-height: 1.25 !important;
                    }
                    .page * {
                        line-height: 1.25 !important;
                    }
                    .page h1,
                    .page h2,
                    .page .h1,
                    .page .h2 {
                        font-size: 16.5pt !important;
                        line-height: 1.2 !important;
                    }
                    .page .text-muted,
                    .page small,
                    .page .small {
                        font-size: 9.5pt !important;
                    }
                    .o_vataga_internal_transfer_report {
                        width: 100% !important;
                        table-layout: fixed !important;
                    }
                    .o_vataga_internal_transfer_report thead {
                        display: table-header-group;
                    }
                    .o_vataga_internal_transfer_report tr {
                        page-break-inside: avoid;
                    }
                    .o_vataga_internal_transfer_report th {
                        font-size: 9.8pt !important;
                        font-weight: 700 !important;
                        text-align: center !important;
                        vertical-align: middle !important;
                    }
                    .o_vataga_internal_transfer_report td {
                        font-size: 10pt !important;
                        vertical-align: top !important;
                    }
                    .o_vataga_internal_transfer_report .o_vataga_col_sequence {
                        width: 4% !important;
                    }
                    .o_vataga_internal_transfer_report .o_vataga_col_product {
                        width: 40% !important;
                        overflow-wrap: break-word;
                        word-wrap: break-word;
                    }
                    .o_vataga_internal_transfer_report .o_vataga_col_quantity,
                    .o_vataga_internal_transfer_report .o_vataga_col_demand,
                    .o_vataga_internal_transfer_report .o_vataga_col_issued {
                        width: 7% !important;
                        text-align: right !important;
                    }
                    .o_vataga_internal_transfer_report .o_vataga_col_uom {
                        width: 5% !important;
                        text-align: center !important;
                    }
                    .o_vataga_internal_transfer_report .o_vataga_col_price,
                    .o_vataga_internal_transfer_report .o_vataga_col_amount {
                        width: 9% !important;
                        text-align: right !important;
                    }
                    .o_vataga_internal_transfer_report .o_vataga_col_barcode {
                        width: 12% !important;
                        word-break: break-word;
                    }
                </style>
                <table class="table table-sm o_main_table o_vataga_internal_transfer_report">
                    <thead>
                        <tr>
                            <th class="o_vataga_col_sequence text-center">&#8470;</th>
                            <th class="o_vataga_col_product">&#1058;&#1086;&#1074;&#1072;&#1088;&#1080; (&#1055;&#1086;&#1089;&#1083;&#1091;&#1075;&#1080;)</th>
                            <th class="o_vataga_col_quantity text-center">&#1050;&#1110;&#1083;-&#1090;&#1100;</th>
                            <th class="o_vataga_col_demand text-center">&#1055;&#1086;&#1087;&#1080;&#1090;</th>
                            <th class="o_vataga_col_issued text-center">&#1042;&#1080;&#1076;&#1072;&#1085;&#1086;</th>
                            <th class="o_vataga_col_uom text-center">&#1054;&#1076;.</th>
                            <th class="o_vataga_col_price text-end">&#1062;&#1110;&#1085;&#1072; &#1073;&#1077;&#1079; &#1055;&#1044;&#1042;</th>
                            <th class="o_vataga_col_amount text-end">&#1057;&#1091;&#1084;&#1072; &#1073;&#1077;&#1079; &#1055;&#1044;&#1042;</th>
                            <th class="o_vataga_col_barcode">&#1064;&#1090;&#1088;&#1080;&#1093;-&#1082;&#1086;&#1076; &#1090;&#1086;&#1074;&#1072;&#1088;&#1091;</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_number" t-value="0"/>
                        <t t-foreach="lines" t-as="move">
                            <t t-set="line_number" t-value="line_number + 1"/>
                            <t
                                t-set="qty"
                                t-value="move.quantity if o.state == 'done' else move.product_uom_qty"
                            />
                            <t t-set="unit_cost" t-value="move.product_id.standard_price"/>
                            <tr>
                                <td class="o_vataga_col_sequence text-center">
                                    <span t-esc="line_number"/>
                                </td>
                                <td class="o_vataga_col_product">
                                    <span t-esc="move.product_id.display_name"/>
                                </td>
                                <td class="o_vataga_col_quantity text-end">
                                    <span t-esc="qty"/>
                                </td>
                                <td class="o_vataga_col_demand text-end">
                                    <span t-field="move.product_uom_qty"/>
                                </td>
                                <td class="o_vataga_col_issued text-end">
                                    <span t-field="move.quantity"/>
                                </td>
                                <td class="o_vataga_col_uom text-center">
                                    <span t-field="move.product_uom"/>
                                </td>
                                <td class="o_vataga_col_price text-end">
                                    <span t-esc="unit_cost"/>
                                </td>
                                <td class="o_vataga_col_amount text-end">
                                    <span t-esc="unit_cost * qty"/>
                                </td>
                                <td class="o_vataga_col_barcode">
                                    <span t-esc="move.product_id.barcode or ''"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </xpath>

        <xpath
            expr="//table[.//span[@t-field='move.product_uom_qty' or (@t-esc and contains(@t-esc, 'move.product_uom_qty') and not(contains(@t-esc, 'unit_cost')))] and .//*[contains(@t-esc, 'unit_cost') and contains(@t-esc, 'move.product_uom_qty')]]"
            position="attributes"
        >
            <attribute name="t-if">o.picking_type_id.code != 'internal'</attribute>
        </xpath>
    </template>
</odoo>
