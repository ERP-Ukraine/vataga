<templates>
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter-topbar')]//span[hasclass('o-mail-Chatter-topbarGrow')]" position="before">
            <button t-if="showProductAutologToggle"
                type="button"
                class="o-mail-Chatter-productAutologToggle btn text-nowrap mx-1 px-2"
                t-att-class="{
                    'btn-secondary': !state.hideProductAutologs,
                    'btn-outline-secondary': state.hideProductAutologs,
                    'my-2': !props.compactHeight,
                }"
                t-att-aria-pressed="!state.hideProductAutologs ? 'true' : 'false'"
                t-att-disabled="state.reloadingProductAutologs || state.thread?.status === 'loading'"
                t-on-click="toggleProductAutologs">
                <i class="fa me-1" t-att-class="state.hideProductAutologs ? 'fa-toggle-off' : 'fa-toggle-on'"/>
                <span>Автологи</span>
            </button>
        </xpath>
    </t>
</templates>
