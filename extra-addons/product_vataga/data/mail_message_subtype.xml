<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mt_product_autolog" model="mail.message.subtype">
        <field name="name">Автологи товару</field>
        <field name="description">Автозапис змін товару</field>
        <field name="default" eval="False"/>
        <field name="internal" eval="True"/>
        <field name="hidden" eval="True"/>
    </record>
    <record id="product_autolog_company_rule" model="ir.rule">
        <field name="name">Автологи товару доступні в межах компанії</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="domain_force">
            ['|', ('product_autolog_company_id', '=', False),
                  ('product_autolog_company_id', 'parent_of', company_ids)]
        </field>
    </record>
</odoo>
