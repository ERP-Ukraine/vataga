<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_component_availability_form" model="ir.ui.view">
        <field name="name">mrp.component.availability.form</field>
        <field name="model">mrp.component.availability</field>
        <field name="arch" type="xml">
            <form string="Наявність комплектуючих" class="w-100 mw-100">
                <div class="w-100">
                    <field name="product_tmpl_id" invisible="1"/>
                    <field name="checked" invisible="1"/>
                    <group col="8">
                        <field name="product_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('type', 'in', ['product', 'consu']), '|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                        <field name="bom_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('product_tmpl_id', '=', product_tmpl_id), '|', ('product_id', '=', False), ('product_id', '=', product_id), '|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                        <field name="quantity"/>
                        <field name="warehouse_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_open': True}"
                               domain="[('company_id', 'in', allowed_company_ids)]"/>
                    </group>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <button name="action_check" type="object" string="Перевірити" class="oe_highlight"/>
                        <button name="action_open_results" type="object" string="Відкрити результати"
                                class="btn-secondary" invisible="not checked"/>
                        <span>Кількість готового товару в одиницях:</span>
                        <field name="product_uom_id" options="{'no_open': True}"/>
                    </div>
                    <p class="text-muted">Попит на 1 — теоретична норма BOM. Попит загальний — потреба після врахування готових підзбірок.</p>
                    <div class="alert alert-success" invisible="not checked or line_ids">
                        Комплектуючих достатньо для вказаної кількості товару.
                    </div>
                    <field name="line_ids" nolabel="1">
                        <tree create="0" edit="0" delete="0" open_form_view="0" default_order="category_id, product_id, id">
                            <field name="category_id" options="{'no_open': True}"/>
                            <field name="product_id" options="{'no_open': True}"/>
                            <field name="default_code" optional="show"/>
                            <field name="demand_per_unit" optional="show"/>
                            <field name="total_demand" optional="show"/>
                            <field name="free_qty" optional="show"/>
                            <field name="reserved_qty" optional="show"/>
                            <field name="shortage_qty" optional="show"/>
                            <field name="uom_id" optional="show" options="{'no_open': True}"/>
                        </tree>
                    </field>
                </div>
            </form>
        </field>
    </record>
    <record id="view_mrp_component_availability_line_tree" model="ir.ui.view">
        <field name="name">mrp.component.availability.line.tree</field>
        <field name="model">mrp.component.availability.line</field>
        <field name="arch" type="xml">
            <tree string="Нестача комплектуючих" create="0" edit="0" delete="0"
                  default_order="category_id, product_id, id">
                <field name="category_id" options="{'no_open': True}"/>
                <field name="product_id" options="{'no_open': True}"/>
                <field name="default_code" optional="show"/>
                <field name="demand_per_unit" optional="show"/>
                <field name="total_demand" optional="show"/>
                <field name="free_qty" optional="show"/>
                <field name="reserved_qty" optional="show"/>
                <field name="shortage_qty" optional="show"/>
                <field name="uom_id" optional="show" options="{'no_open': True}"/>
            </tree>
        </field>
    </record>
    <record id="view_mrp_component_availability_line_search" model="ir.ui.view">
        <field name="name">mrp.component.availability.line.search</field>
        <field name="model">mrp.component.availability.line</field>
        <field name="arch" type="xml">
            <search string="Пошук комплектуючих">
                <field name="product_id" string="Товар"
                       filter_domain="['|', ('product_id.name', 'ilike', self), ('default_code', 'ilike', self)]"/>
                <field name="default_code"/>
                <field name="category_id"/>
                <separator/>
                <filter name="shortage" string="Товари з нестачею" domain="[('shortage_qty', '&gt;', 0)]"/>
                <separator/>
                <filter name="has_code" string="З кодом товару" domain="[('default_code', '!=', False)]"/>
                <group expand="0" string="Групувати за">
                    <filter name="group_category" string="Категорія товару" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_mrp_component_availability_lines" model="ir.actions.act_window">
        <field name="name">Результати перевірки комплектуючих</field>
        <field name="res_model">mrp.component.availability.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_mrp_component_availability_line_tree"/>
        <field name="search_view_id" ref="view_mrp_component_availability_line_search"/>
        <field name="domain">[('id', '=', False)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="target">current</field>
    </record>
    <record id="action_mrp_component_availability" model="ir.actions.act_window">
        <field name="name">Наявність комплектуючих</field>
        <field name="res_model">mrp.component.availability</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mrp_component_availability_form"/>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_mrp_component_availability" name="Наявність комплектуючих"
              parent="mrp.menu_mrp_reporting" action="action_mrp_component_availability"
              groups="mrp.group_mrp_user" sequence="40"/>
</odoo>
