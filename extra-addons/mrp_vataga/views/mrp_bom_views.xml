<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_autolog_toggle" model="ir.ui.view">
        <field name="name">mrp.bom.form.autolog.toggle</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_chatter')]" position="inside">
                <field name="bom_autologs_enabled" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
