<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_currency_form_nbu_update" model="ir.ui.view">
        <field name="name">res.currency.form.nbu.update</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button
                        name="action_update_nbu_currency_rates"
                        string="Update NBU Rates"
                        type="object"
                        class="oe_highlight"
                        groups="account.group_account_manager,base.group_system"
                    />
                </header>
            </xpath>
        </field>
    </record>

</odoo>
