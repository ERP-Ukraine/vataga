<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_embed" model="ir.actions.client">
        <field name="name">Ratel Support</field>
        <field name="tag">ratel_support_embed.embed</field>
    </record>
    <menuitem id="menu_root" name="Ratel Support" action="action_embed"
              web_icon="ratel_support_embed,static/description/icon.png"
              groups="ratel_support_embed.group_user" sequence="90"/>
    <!-- Плитка на головному екрані — одразу після «Служби підтримки» -->
    <record id="menu_root" model="ir.ui.menu">
        <field name="sequence" model="ir.ui.menu" eval="obj(ref('helpdesk.menu_helpdesk_root')).sequence + 1"/>
    </record>
</odoo>
