<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="stock_minimum_control_vataga.Action">
        <WithSearch t-props="searchProps" t-slot-scope="search">
            <StockMinimumPanel domain="search.domain" display="search.display"/>
        </WithSearch>
    </t>
    <t t-name="stock_minimum_control_vataga.Panel">
        <Layout display="props.display" className="'h-100'">
            <t t-set-slot="control-panel-additional-actions"><CogMenu/></t>
            <t t-set-slot="layout-actions"><SearchBar t-if="searchBarToggler.state.showSearchBar"/></t>
            <t t-set-slot="control-panel-navigation-additional">
                <t t-component="searchBarToggler.component" t-props="searchBarToggler.props"/>
            </t>
            <StockMinimumReport domain="props.domain"/>
        </Layout>
    </t>
    <t t-name="stock_minimum_control_vataga.Report">
        <div class="o_stock_minimum_control d-flex flex-column h-100 overflow-hidden">
            <div class="o_pivot_buttons d-flex gap-1 mt-2 mx-3 mb-3">
                <div class="btn-group" role="toolbar" aria-label="Міри">
                    <t t-call="web.ReportViewMeasures">
                        <t t-set="measures" t-value="this.measures"/>
                        <t t-set="activeMeasures" t-value="selection.measures"/>
                    </t>
                </div>
                <div class="btn-group" role="toolbar" aria-label="Дії звіту">
                    <button class="btn btn-secondary fa fa-arrows o_pivot_expand_button" t-on-click="expandAll" data-tooltip="Розгорнути все" aria-label="Розгорнути все" t-att-disabled="state.busy || !state.data"/>
                    <button class="btn btn-secondary fa fa-download o_pivot_download" t-on-click="downloadXlsx" data-tooltip="Завантажити XLSX" aria-label="Завантажити XLSX" t-att-disabled="state.busy || !state.data"/>
                    <button class="btn btn-secondary fa fa-refresh" t-on-click="load" data-tooltip="Оновити" aria-label="Оновити" t-att-disabled="state.busy"/>
                </div>
            </div>
            <div t-if="state.error" class="alert alert-danger m-3" role="alert">
                Не вдалося завантажити звіт. Перевірте доступ та натисніть «Оновити».
            </div>
            <t t-if="state.data">
                <div t-if="!state.data.warehouses.length" class="alert alert-info m-3">
                    Немає доступних складів із увімкненим контролем мінімальних залишків.
                </div>
                <div t-elif="!state.data.count" class="alert alert-info m-3">Товари не знайдено.</div>
                <div t-else="" class="o_pivot mx-3 flex-grow-1 overflow-auto" t-att-aria-busy="state.busy">
                    <table class="table-hover table table-sm table-bordered table-borderless o_pivot_table mb-0"
                           t-ref="table" t-att-style="tableStyle" t-att-class="{o_resizing: layout.resizing}">
                        <colgroup>
                            <col t-foreach="leafKeys" t-as="key" t-key="key" t-att-data-column-key="key" t-att-style="'width: ' + columnWidth(key) + 'px'"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <th rowspan="3" class="o_smc_label bg-view fw-normal opacity-trigger-hover" data-column-key="product" t-att-class="resizeClass('product')">
                                    Товар
                                    <t t-call="stock_minimum_control_vataga.ResizeHandle"><t t-set="resizeKey" t-value="'product'"/></t>
                                </th>
                                <th rowspan="3" class="o_smc_minimum bg-view text-muted text-center fw-normal opacity-trigger-hover" data-column-key="minimum" t-att-class="resizeClass('minimum')">
                                    Мінімальна кількість
                                    <t t-call="stock_minimum_control_vataga.ResizeHandle"><t t-set="resizeKey" t-value="'minimum'"/></t>
                                </th>
                                <th t-foreach="state.data.warehouses" t-as="warehouse" t-key="warehouse.id" t-if="activeIndexes.length"
                                    t-att-colspan="warehouse.columns.length * activeIndexes.length" t-att-rowspan="warehouse.expanded ? 1 : 2"
                                    class="bg-view border-top fw-normal user-select-none o_smc_group_header"
                                    t-att-class="warehouse.expanded ? 'o_pivot_header_cell_opened' : 'o_pivot_header_cell_closed'">
                                    <button class="o_smc_toggle" t-on-click="() => this.toggleWarehouse(warehouse.id)"
                                            t-att-disabled="state.busy || !warehouse.can_expand" t-att-aria-expanded="warehouse.expanded">
                                        <i aria-hidden="true" t-att-class="warehouse.expanded ? 'fa fa-minus-square-o me-1' : 'fa fa-plus-square me-1'"/>
                                        <t t-esc="warehouse.name"/>
                                    </button>
                                </th>
                            </tr>
                            <tr>
                                <t t-foreach="state.data.warehouses" t-as="warehouse" t-key="warehouse.id">
                                    <t t-if="warehouse.expanded and activeIndexes.length">
                                        <th t-foreach="warehouse.columns" t-as="column" t-key="column.key" t-att-colspan="activeIndexes.length" class="bg-view border-top fw-normal o_smc_group_header" t-att-title="column.name">
                                            <t t-esc="column.name"/>
                                        </th>
                                    </t>
                                </t>
                            </tr>
                            <tr>
                                <t t-foreach="columns" t-as="column" t-key="column.key">
                                    <th t-foreach="activeIndexes" t-as="measure" t-key="measure"
                                        class="bg-view text-muted text-center fw-normal o_pivot_measure_row position-relative opacity-trigger-hover"
                                        t-att-data-column-key="measureKey(column, measure)" t-att-title="Object.values(measures)[measure].string" t-att-class="resizeClass(measureKey(column, measure))">
                                        <t t-esc="Object.values(measures)[measure].string"/>
                                        <t t-call="stock_minimum_control_vataga.ResizeHandle"><t t-set="resizeKey" t-value="measureKey(column, measure)"/></t>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rows" t-as="row" t-key="row.key" t-att-class="row.kind !== 'product' ? 'fw-bold' : ''">
                                <t t-if="row.kind === 'page'">
                                    <td class="align-top o_smc_label bg-view">
                                        <button class="btn btn-sm btn-secondary me-2" t-att-disabled="state.busy || !row.page"
                                                t-on-click="() => this.changePage(row, -1)" aria-label="Попередня сторінка">‹</button>
                                        <t t-esc="row.page * state.data.page_size + 1"/>–<t t-esc="Math.min((row.page + 1) * state.data.page_size, row.count)"/>
                                        / <t t-esc="row.count"/>
                                        <button class="btn btn-sm btn-secondary ms-2"
                                                t-att-disabled="state.busy || (row.page + 1) * state.data.page_size >= row.count"
                                                t-on-click="() => this.changePage(row, 1)" aria-label="Наступна сторінка">›</button>
                                    </td>
                                    <td class="align-top o_smc_minimum bg-100"/>
                                    <td t-if="activeIndexes.length" t-att-colspan="columns.length * activeIndexes.length"/>
                                </t>
                                <t t-else="">
                                    <th class="align-top o_smc_label bg-view user-select-none" scope="row" t-att-class="rowHeaderClass(row)">
                                        <button t-if="row.kind === 'total'" class="o_smc_toggle fw-bold"
                                                t-on-click="() => state.totalExpanded = !state.totalExpanded" t-att-aria-expanded="state.totalExpanded">
                                            <i aria-hidden="true" t-att-class="state.totalExpanded ? 'fa fa-minus-square-o me-1' : 'fa fa-plus-square me-1'"/>Разом
                                        </button>
                                        <button t-elif="row.kind === 'category'" class="o_smc_toggle fw-bold"
                                                t-on-click="() => this.toggleCategory(row.id)" t-att-disabled="state.busy"
                                                t-att-aria-expanded="state.categories.includes(row.id)">
                                            <i aria-hidden="true" t-att-class="state.categories.includes(row.id) ? 'fa fa-minus-square-o me-1' : 'fa fa-plus-square me-1'"/>
                                            <t t-esc="row.name"/>
                                        </button>
                                        <span t-else="" class="d-block fw-normal" t-att-title="row.name">
                                            <t t-esc="row.name"/> <small class="text-muted">(<t t-esc="row.uom"/>)</small>
                                        </span>
                                    </th>
                                    <td class="align-top o_smc_minimum bg-100 text-end" t-att-class="resizeClass('minimum')"><t t-if="row.kind === 'product'" t-esc="format(row.minimum)"/></td>
                                    <t t-foreach="columns" t-as="column" t-key="column.key">
                                        <td t-foreach="activeIndexes" t-as="measure" t-key="measure"
                                            class="align-top o_pivot_cell_value bg-100 text-end text-nowrap" t-att-class="cellClass(row, column, measure) + ' ' + resizeClass(measureKey(column, measure))">
                                            <div class="o_value w-100 text-end" t-esc="format(row.values[column.key][measure])"/>
                                        </td>
                                    </t>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </t>
    <t t-name="stock_minimum_control_vataga.ResizeHandle">
        <span class="o_resize position-absolute top-0 end-0 bottom-0 ps-1 bg-black-25 opacity-0 opacity-50-hover z-index-1"
              t-att-class="layout.resizing === resizeKey ? 'bg-primary opacity-100' : ''"
              role="separator" aria-orientation="vertical" aria-label="Змінити ширину колонки" tabindex="0"
              t-att-aria-valuenow="columnWidth(resizeKey)" t-att-aria-valuemin="minimumWidth(resizeKey)"
              t-on-click.stop.prevent="" t-on-pointerdown.stop.prevent="(ev) => this.onStartResize(ev, resizeKey)"
              t-on-keydown="(ev) => this.onResizeKey(ev, resizeKey)"/>
    </t>
</templates>
