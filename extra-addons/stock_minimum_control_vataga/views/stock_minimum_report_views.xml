<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_minimum_search" model="ir.ui.view">
        <field name="name">stock.minimum.control.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Контроль залишків">
                <field name="name" string="Товар" filter_domain="['|', ('name', 'ilike', self), ('default_code', 'ilike', self)]"/>
                <field name="categ_id" string="Категорія товару"/>
            </search>
        </field>
    </record>
    <record id="action_stock_minimum_control" model="ir.actions.client">
        <field name="name">Контроль залишків</field>
        <field name="tag">stock_minimum_control_vataga.report</field>
        <field name="params" eval="{'search_view_id': ref('view_stock_minimum_search')}"/>
    </record>
    <menuitem id="menu_stock_minimum_control" name="Контроль залишків"
              parent="stock.menu_warehouse_report" sequence="6"
              action="action_stock_minimum_control" groups="stock.group_stock_user"/>
</odoo>
