<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_alert_board_form" model="ir.ui.view">
        <field name="name">quality.alert.technical.board</field>
        <field name="model">quality.alert</field>
        <field name="inherit_id" ref="quality_control.quality_alert_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="widget">statusbar</attribute>
                <attribute name="domain">[('id', 'in', [%(quality_vataga.quality_alert_stage_new)d, %(quality_vataga.quality_alert_stage_board_analysis)d, %(quality_vataga.quality_alert_stage_board_approval)d, %(quality_vataga.quality_alert_stage_board_execution)d, %(quality_vataga.quality_alert_stage_closed)d])]</attribute>
                <attribute name="options">{'clickable': False, 'no_create': True, 'no_open': True}</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//page[@name='miscellaneous']" position="after">
                <page name="vataga_matrix_failure_history" string="Історія невідповідностей"
                      invisible="not vataga_matrix_failure_snapshot">
                    <field name="vataga_matrix_failure_snapshot" nolabel="1" readonly="1"
                           class="w-100 text-break"/>
                </page>
            </xpath>
            <!-- Own controls: no dependency on an Enterprise header or notebook. -->
            <xpath expr="/form/sheet | /form[not(sheet)]" position="inside">
                <group name="vataga_sorting_parameters" string="Параметри невідповідності"
                       col="2" class="w-100">
                    <field name="x_sorting_parameter" nolabel="1" colspan="2" class="w-100 text-break"/>
                </group>
                <group name="technical_board_action">
                    <field name="is_new_stage" invisible="1"/>
                    <field name="is_board_analysis_stage" invisible="1"/>
                    <field name="is_board_approval_stage" invisible="1"/>
                    <field name="is_board_execution_stage" invisible="1"/>
                    <button name="action_send_to_analysis" type="object"
                            string="Передати на аналіз" class="oe_highlight"
                            invisible="not is_new_stage"/>
                    <button name="action_send_for_board_approval" type="object"
                            string="Передати на затвердження" class="oe_highlight"
                            invisible="is_approved or not is_board_analysis_stage"/>
                    <button name="action_approve_technical_board" type="object"
                            string="Затвердити рішення" class="oe_highlight"
                            groups="quality_vataga.group_quality_board_approval"
                            invisible="is_approved or not is_board_approval_stage or approval_user_id != uid"/>
                    <button name="action_close_alert" type="object" string="Закрити сповіщення"
                            groups="quality.group_quality_manager"
                            invisible="not is_board_execution_stage"/>
                </group>
                <group string="Рішення Технічної ради">
                    <group>
                        <field name="decision_type" readonly="is_approved"/>
                        <field name="approval_user_id" readonly="is_approved" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="is_approved" readonly="1"/>
                        <field name="approved_by_id" readonly="1" invisible="not is_approved"/>
                        <field name="approved_at" readonly="1" invisible="not is_approved"/>
                        <field name="vataga_closed_by_id" readonly="1" invisible="not vataga_closed_at"/>
                        <field name="vataga_closed_at" readonly="1" invisible="not vataga_closed_at"/>
                    </group>
                </group>
                <notebook name="technical_board_notebook" invisible="decision_type != 'full_control'">
                    <page string="Суцільний контроль" name="technical_board_full_control">
                        <field name="full_control_line_ids" readonly="vataga_closed_at">
                            <tree editable="bottom">
                                <field name="date"/>
                                <field name="checked_qty"/>
                                <field name="good_qty"/>
                                <field name="bad_qty"/>
                                <field name="inspector_id"/>
                            </tree>
                        </field>
                        <group>
                            <field name="full_control_checked_qty"/>
                            <field name="full_control_good_qty"/>
                            <field name="full_control_bad_qty"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
