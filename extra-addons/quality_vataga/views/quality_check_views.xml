<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_check_view_form_measurement_matrix" model="ir.ui.view">
        <field name="name">quality.check.form.measurement.matrix</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <widget name="quality_unit_admission_buttons" groups="quality.group_quality_user"
                        invisible="x_control_stage != 'in_process' or not operation_run_id"/>
                <button name="action_open_identification_wizard" type="object" string="Ідентифікувати вироби"
                        groups="quality.group_quality_user" class="btn-secondary"
                        invisible="x_control_stage != 'in_process' or quality_state != 'none' or operation_run_id or not in_process_result_quantities_valid"/>
                <button
                    name="action_open_matrix_quality_alert"
                    type="object"
                    string="Створити сповіщення"
                    class="btn-secondary"
                    invisible="not can_create_matrix_quality_alert"
                />
                <button
                    name="action_initialize_measurement_matrix"
                    type="object"
                    string="Ініціалізувати матрицю"
                    class="btn-secondary"
                    invisible="not can_initialize_measurement_matrix"
                />
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="can_create_matrix_quality_alert" invisible="1"/>
                <field
                    name="can_initialize_measurement_matrix"
                    invisible="1"
                />
                <field name="measurement_matrix_required" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='measure_on']" position="after">
                <field name="x_control_stage" readonly="1"/>
                <field
                    name="has_operation_product_quantity"
                    invisible="1"
                />
                <field
                    name="operation_product_quantity_label"
                    readonly="1"
                    invisible="not has_operation_product_quantity"
                />
                <field
                    name="arrival_warehouse_id"
                    readonly="1"
                    invisible="not picking_id"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field
                    name="arrival_scheduled_date"
                    readonly="1"
                    invisible="not picking_id"
                />
            </xpath>

            <xpath expr="//sheet/notebook" position="before">
                <group name="quality_vataga_control_results" string="Результати контролю"
                       invisible="x_control_stage != 'in_process'">
                    <field name="quality_transfer_controlled" invisible="1"/>
                    <div class="alert alert-warning" colspan="2" invisible="not quality_transfer_controlled">
                        Активний захищений поштучний маршрут. Стандартне завершення Work Orders і складський випуск заблоковані.
                        Приймання не є запуском обробки; для виконання оберіть конкретні QUNIT у робочому завданні.
                    </div>
                    <group>
                        <field name="in_process_sample_quantity" readonly="1"/>
                        <field name="operation_run_id" readonly="1" options="{'no_create': True}"/>
                        <field name="unit_admission_role" groups="quality.group_quality_manager"/>
                        <field name="in_process_result_quantities_valid" invisible="1"/>
                        <div colspan="2" class="text-muted">
                            PASS не є допуском. Допуск конкретних виробів підтверджується інспектором окремо.
                        </div>
                        <div colspan="2" class="alert alert-warning mb-0"
                             invisible="in_process_result_quantities_valid">
                            Матрицю партії не сформовано або кількість зразків
                            не відповідає зафіксованій партії.
                        </div>
                    </group>
                    <group>
                        <field name="x_passed_qty" readonly="1"/>
                        <field name="x_failed_qty" readonly="1"/>
                        <field name="x_pending_qty" readonly="1"/>
                        <field name="x_admitted_qty" readonly="1"/>
                        <field name="x_held_qty" readonly="1"/>
                        <field name="x_transferred_qty" readonly="1"/>
                        <field name="x_received_qty" readonly="1"/>
                        <field name="x_awaiting_transfer_qty" readonly="1"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page name="quality_unit_transfers" string="Передачі виробів" invisible="not operation_run_id">
                    <field name="unit_transfer_ids" readonly="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="controlled_unit_id"/>
                            <field name="destination_workorder_id"/>
                            <field name="state"/>
                            <field name="sent_by_id"/>
                            <field name="sent_at"/>
                            <field name="received_by_id"/>
                            <field name="received_at"/>
                            <field name="return_reason"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page name="quality_unit_admission_history" string="Історія допусків" invisible="x_control_stage != 'in_process'" groups="quality.group_quality_user">
                    <field name="unit_admission_ids" readonly="1" nolabel="1"/>
                </page>
                <page
                    string="Показники"
                    name="quality_vataga_measurements"
                    invisible="not measurement_matrix_required"
                >
                    <field name="measurement_column_ids" invisible="1"/>
                    <field name="sample_ids" invisible="1"/>
                    <field name="measurement_matrix_complete" invisible="1"/>
                    <field
                        name="measurement_matrix_has_failure"
                        invisible="1"
                    />
                    <field
                        name="equipment_selection_complete"
                        invisible="1"
                    />
                    <field
                        name="can_pass_measurement_check"
                        invisible="1"
                    />

                    <group
                        string="Використані ЗВТ"
                        col="1"
                        invisible="not equipment_selection_ids"
                    >
                        <field
                            name="equipment_selection_ids"
                            nolabel="1"
                            readonly="quality_state != 'none'"
                            domain="[('requires_equipment_selection', '=', True)]"
                        >
                            <tree
                                editable="bottom"
                                create="0"
                                delete="0"
                                default_order="sequence, id"
                            >
                                <field name="sequence" column_invisible="True"/>
                                <field
                                    name="equipment_category_id"
                                    column_invisible="True"
                                />
                                <field
                                    name="required_equipment_category_ids"
                                    column_invisible="True"
                                />
                                <field
                                    name="requires_equipment_selection"
                                    column_invisible="True"
                                />
                                <field
                                    name="equipment_category_names_display"
                                    string="Допустимі категорії ЗВТ"
                                    readonly="1"
                                />
                                <field
                                    name="equipment_ids"
                                    string="Конкретне обладнання"
                                    widget="many2many_tags"
                                    domain="[('category_id', 'in', required_equipment_category_ids)]"
                                    context="{'quality_vataga_equipment_selection': True}"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    column_invisible="parent.quality_state != 'none'"
                                />
                                <field
                                    name="equipment_display_list_snapshot"
                                    string="Конкретне обладнання"
                                    readonly="1"
                                    column_invisible="parent.quality_state == 'none'"
                                />
                            </tree>
                        </field>
                    </group>

                    <field
                        name="measurement_matrix_data"
                        widget="quality_measurement_matrix"
                        nolabel="1"
                        readonly="1"
                        class="w-100 o_quality_measurement_matrix_field"
                    />
                </page>
            </xpath>
        </field>
    </record>

    <record id="quality_check_view_tree_arrival_details" model="ir.ui.view">
        <field name="name">quality.check.tree.arrival.details</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree/field[@name='picking_id']" position="attributes">
                <attribute name="string">Номер надходження</attribute>
            </xpath>
            <field name="quality_state" position="before">
                <field
                    name="operation_product_quantity_label"
                    string="Кількість товару"
                    optional="show"
                />
                <field name="arrival_warehouse_id" optional="show"/>
                <field
                    name="production_id"
                    string="Виробництво"
                    optional="show"
                />
                <field name="arrival_scheduled_date" optional="show"/>
            </field>
        </field>
    </record>

    <record id="quality_check_view_search_arrival_details" model="ir.ui.view">
        <field name="name">quality.check.search.arrival.details</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="picking_id" string="Номер надходження"/>
                <field name="arrival_warehouse_id"/>
                <field name="production_id" string="Виробництво"/>
                <field name="arrival_scheduled_date"/>
                <group expand="0" string="Групувати за">
                    <filter
                        string="Склад"
                        name="group_by_arrival_warehouse"
                        context="{'group_by': 'arrival_warehouse_id'}"
                    />
                    <filter
                        string="Виробництво"
                        name="group_by_production"
                        context="{'group_by': 'production_id'}"
                    />
                    <filter
                        string="Запланована дата надходження"
                        name="group_by_arrival_scheduled_date"
                        context="{'group_by': 'arrival_scheduled_date'}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
