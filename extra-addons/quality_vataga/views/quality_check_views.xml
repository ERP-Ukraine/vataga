<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_check_view_form_measurement_matrix" model="ir.ui.view">
        <field name="name">quality.check.form.measurement.matrix</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality.quality_check_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page
                    string="Показники"
                    name="quality_vataga_measurements"
                    invisible="not measurement_column_ids"
                >
                    <field name="measurement_column_ids" invisible="1"/>
                    <field name="sample_ids" invisible="1"/>
                    <field name="measurement_matrix_complete" invisible="1"/>
                    <field
                        name="measurement_matrix_has_failure"
                        invisible="1"
                    />
                    <field
                        name="equipment_selection_complete"
                        invisible="1"
                    />
                    <field
                        name="can_pass_measurement_check"
                        invisible="1"
                    />

                    <group string="Використані ЗВТ" col="1">
                        <field
                            name="equipment_selection_ids"
                            nolabel="1"
                            readonly="quality_state != 'none'"
                        >
                            <tree
                                editable="bottom"
                                create="0"
                                delete="0"
                                default_order="sequence, id"
                            >
                                <field name="sequence" column_invisible="True"/>
                                <field
                                    name="equipment_category_id"
                                    column_invisible="True"
                                />
                                <field
                                    name="equipment_category_name"
                                    string="Категорія ЗВТ"
                                    readonly="1"
                                />
                                <field
                                    name="equipment_id"
                                    domain="[('category_id', '=', equipment_category_id)]"
                                    context="{'quality_vataga_equipment_selection': True}"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                />
                            </tree>
                        </field>
                    </group>

                    <div class="alert alert-info" role="alert"
                         invisible="sample_ids">
                        Автоматичне джерело обсягу вибірки не знайдено.
                        Вкажіть кількість і додайте зразки вручну.
                    </div>
                    <group col="4">
                        <field
                            name="sample_count_to_add"
                            readonly="quality_state != 'none'"
                        />
                        <button
                            name="action_add_measurement_samples"
                            type="object"
                            string="Додати зразки"
                            class="btn-primary"
                            invisible="quality_state != 'none'"
                        />
                    </group>

                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="not measurement_matrix_has_failure"
                    >
                        Матриця містить невідповідності. Успішне завершення
                        перевірки недоступне.
                    </div>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="can_pass_measurement_check or measurement_matrix_has_failure"
                    >
                        Для успішного завершення виберіть усі ЗВТ і заповніть
                        усі показники щонайменше одного зразка.
                    </div>

                    <field
                        name="measurement_matrix_data"
                        widget="quality_measurement_matrix"
                        nolabel="1"
                        readonly="1"
                    />
                </page>
            </xpath>

            <xpath expr="//button[@name='do_pass']" position="attributes">
                <attribute
                    name="invisible"
                    add="measurement_column_ids and not can_pass_measurement_check"
                    separator=" or "
                />
            </xpath>
        </field>
    </record>
</odoo>
