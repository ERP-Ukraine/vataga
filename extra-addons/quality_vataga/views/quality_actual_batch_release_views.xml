<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_quality_actual_batch" model="ir.ui.view">
        <field name="name">mrp.production.quality.actual.batch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form/header" position="inside">
                <field name="quality_actual_batch_available" invisible="1"/>
                <button name="action_release_quality_actual_batch" type="object"
                        string="Випустити фактичну партію" class="btn-primary"
                        groups="mrp.group_mrp_user,stock.group_stock_user"
                        invisible="not quality_actual_batch_available"
                        confirm="Випустити на склад усі фактично виготовлені та допущені вироби й створити виробниче замовлення на невиготовлений залишок?"/>
            </xpath>
        </field>
    </record>
</odoo>
