<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_unit_native_history_form" model="ir.ui.view">
        <field name="name">quality.production.unit.native.history</field>
        <field name="model">quality.production.unit</field>
        <field name="inherit_id" ref="quality_vataga.quality_production_unit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="quality_native_history" string="Штатний випуск / Backorder"
                      invisible="not native_continuation_ids and not native_stock_fact_ids">
                    <field name="native_continuation_ids" readonly="1" nolabel="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="source_production_id"/>
                            <field name="production_id"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </tree>
                    </field>
                    <field name="native_stock_fact_ids" readonly="1" nolabel="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="production_id"/>
                            <field name="move_line_id"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="mrp_native_quality_history_form" model="ir.ui.view">
        <field name="name">mrp.production.native.quality.history</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page name="quality_native_history" string="QUNIT / Backorder"
                      invisible="not native_continuation_ids and not native_stock_fact_ids">
                    <group>
                        <field name="quality_native_parent_id" readonly="1"/>
                    </group>
                    <field name="native_continuation_ids" readonly="1" nolabel="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="unit_id"/>
                            <field name="source_production_id"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </tree>
                    </field>
                    <field name="native_stock_fact_ids" readonly="1" nolabel="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="unit_id"/>
                            <field name="move_line_id"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
