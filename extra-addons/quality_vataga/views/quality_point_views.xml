<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_point_view_form_control_settings" model="ir.ui.view">
        <field name="name">quality.point.form.control.settings</field>
        <field name="model">quality.point</field>
        <field name="inherit_id" ref="quality.quality_point_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Налаштування контролю" name="control_settings">
                    <group>
                        <field name="visual_sample_control_required"/>
                    </group>
                    <field name="control_parameter_line_ids">
                        <tree editable="bottom" default_order="sequence, id">
                            <field name="sequence" widget="handle"/>
                            <field name="control_type"/>
                            <field
                                name="equipment_category_id"
                                column_invisible="True"
                            />
                            <field
                                name="equipment_category_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="available_parameter_ids" column_invisible="True"/>
                            <field
                                name="parameter_id"
                                domain="[('id', 'in', available_parameter_ids), ('active', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="has_min_tolerance" column_invisible="True"/>
                            <field name="min_tolerance" column_invisible="True"/>
                            <field name="parameter_type" column_invisible="True"/>
                            <field
                                name="min_tolerance_input"
                                readonly="parameter_type != 'numeric'"
                            />
                            <field name="has_max_tolerance" column_invisible="True"/>
                            <field name="max_tolerance" column_invisible="True"/>
                            <field
                                name="max_tolerance_input"
                                readonly="parameter_type != 'numeric'"
                            />
                            <field name="text_norm"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
