<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_quality_quarantine" model="ir.ui.view">
        <field name="name">mrp.production.form.quality.quarantine</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="quality_mrp.mrp_production_view_form_inherit_quality"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field name="quality_output_registration_available" invisible="1"/>
                <button name="action_quality_register_production" type="object"
                        string="Зареєструвати виробництво" groups="mrp.group_mrp_user"
                        invisible="not quality_output_registration_available"
                        context="{'quality_registration_quantity': qty_producing, 'quality_registration_lot_id': lot_producing_id}"
                        confirm="Підтвердити поточну кількість фактично виготовлених виробів і партію, вказані в замовленні?"/>
            </xpath>
            <xpath expr="//button[@name='check_quality']" position="attributes">
                <attribute name="string">Виконати перевірки якості</attribute>
            </xpath>
            <xpath expr="//button[@name='%(quality_mrp.quality_check_action_mo)d' and @class='oe_stat_button']" position="attributes">
                <attribute name="name">action_open_quarantine_checks</attribute>
                <attribute name="type">object</attribute>
            </xpath>
            <xpath expr="//button[@name='%(quality_mrp.quality_check_action_mo)d' and @class='oe_stat_button text-success']" position="attributes">
                <attribute name="name">action_open_quarantine_checks</attribute>
                <attribute name="type">object</attribute>
            </xpath>
            <xpath expr="//button[@name='%(quality_mrp.quality_check_action_mo)d' and @class='oe_stat_button text-danger']" position="attributes">
                <attribute name="name">action_open_quarantine_checks</attribute>
                <attribute name="type">object</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_quarantine_checks" type="object" class="oe_stat_button"
                        icon="fa-check-square-o" string="Перевірки якості"
                        groups="quality.group_quality_user" invisible="not quality_quarantine_status or check_ids"/>
            </xpath>
            <xpath expr="//group[@name='group_extra_info']" position="inside">
                <field name="quality_quarantine_status" widget="badge" invisible="not quality_quarantine_status"
                       decoration-warning="quality_quarantine_status in ('pending', 'accepted')"
                       decoration-success="quality_quarantine_status == 'pass'"
                       decoration-danger="quality_quarantine_status == 'fail'"/>
            </xpath>
        </field>
    </record>
</odoo>
