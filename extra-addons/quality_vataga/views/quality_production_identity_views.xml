<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_production_run_tree" model="ir.ui.view">
        <field name="name">quality.production.run.tree</field>
        <field name="model">quality.production.run</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="production_id"/>
                <field name="workorder_id"/>
                <field name="quantity"/>
                <field name="responsible_id"/>
                <field name="create_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    <record id="quality_production_run_form" model="ir.ui.view">
        <field name="name">quality.production.run.form</field>
        <field name="model">quality.production.run</field>
        <field name="arch" type="xml">
            <form string="Запуск операції контролю" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="workorder_id"/>
                            <field name="product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="state"/>
                            <field name="responsible_id"/>
                            <field name="create_date"/>
                            <field name="origin_check_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Історія допусків" groups="quality.group_quality_user">
                            <field name="unit_admission_ids" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Вироби">
                            <field name="unit_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="lot_id"/>
                                    <field name="registration_run_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Перевірки">
                            <field name="check_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="point_id"/>
                                    <field name="quality_state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="quality_production_unit_form" model="ir.ui.view">
        <field name="name">quality.production.unit.form</field>
        <field name="model">quality.production.unit</field>
        <field name="arch" type="xml">
            <form string="Контрольований виріб" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="registration_run_id"/>
                            <field name="lot_id"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Запуски">
                            <field name="run_ids" readonly="1"/>
                        </page>
                        <page string="Контроль">
                            <field name="sample_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="quality_check_id"/>
                                    <field name="sample_number"/>
                                    <field name="sample_result"/>
                                    <field name="x_was_reworked"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
