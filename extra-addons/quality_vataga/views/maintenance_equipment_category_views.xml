<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_equipment_category_view_form_parameters" model="ir.ui.view">
        <field name="name">maintenance.equipment.category.form.parameters</field>
        <field name="model">maintenance.equipment.category</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='technician_user_id']]" position="after">
                <group>
                    <field name="requires_equipment_selection"/>
                    <field
                        name="applicable_parameter_ids"
                        widget="many2many_tags"
                        domain="[('active', '=', True)]"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
