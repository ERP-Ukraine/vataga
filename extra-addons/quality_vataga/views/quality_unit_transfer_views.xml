<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_unit_transfer_form" model="ir.ui.view">
        <field name="name">quality.unit.transfer.form</field>
        <field name="model">quality.unit.transfer</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" string="Історія передачі QUNIT">
                <sheet>
                    <group>
                        <group>
                            <field name="controlled_unit_id"/>
                            <field name="production_id"/>
                            <field name="source_workorder_id"/>
                            <field name="destination_workorder_id"/>
                            <field name="source_run_id"/>
                            <field name="check_id"/>
                            <field name="admission_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="sent_by_id"/>
                            <field name="sent_at"/>
                            <field name="received_by_id"/>
                            <field name="received_at"/>
                            <field name="returned_by_id"/>
                            <field name="returned_at"/>
                            <field name="return_reason"/>
                        </group>
                    </group>
                    <field name="event_ids" readonly="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="action"/>
                            <field name="actor_id"/>
                            <field name="occurred_at"/>
                            <field name="reason"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_workorder_quality_unit_transfers" model="ir.ui.view">
        <field name="name">mrp.workorder.quality.unit.transfers</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page name="quality_unit_transfers" string="Передачі QUNIT" groups="quality.group_quality_user"
                      invisible="not quality_transfer_controlled and not quality_transfer_in_ids and not quality_transfer_out_ids">
                    <field name="quality_transfer_has_run" invisible="1"/>
                    <field name="quality_transfer_controlled" invisible="1"/>
                    <div class="alert alert-warning" invisible="not quality_transfer_controlled">
                        Приймання не запускає обробку виробів. Для явного виконання прийнятих QUNIT відкрийте «Поштучне виконання».
                        Стандартне завершення Work Orders і складський випуск цього MO заблоковані.
                    </div>
                    <widget name="quality_unit_transfer_workorder_buttons"/>
                    <group>
                        <group>
                            <field name="quality_admitted_qty" readonly="1"/>
                            <field name="quality_transferred_qty" readonly="1"/>
                            <field name="quality_received_qty" readonly="1"/>
                        </group>
                        <group>
                            <field name="quality_awaiting_transfer_qty" readonly="1"/>
                            <field name="quality_held_qty" readonly="1"/>
                            <field name="quality_incoming_received_qty" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Вхідні вироби — конкретні ідентифікатори"/>
                    <field name="quality_transfer_in_ids" readonly="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="controlled_unit_id"/>
                            <field name="source_workorder_id"/>
                            <field name="source_run_id"/>
                            <field name="state"/>
                            <field name="sent_at"/>
                            <field name="received_at"/>
                            <field name="return_reason"/>
                        </tree>
                    </field>
                    <separator string="Вихідні передачі та повернення"/>
                    <field name="quality_transfer_out_ids" readonly="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="controlled_unit_id"/>
                            <field name="destination_workorder_id"/>
                            <field name="state"/>
                            <field name="sent_at"/>
                            <field name="received_at"/>
                            <field name="return_reason"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
