<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_equipment_view_form_parameters" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.applicable.parameters</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Параметри" name="parameters">
                    <field
                        name="applicable_parameter_ids"
                        widget="many2many_tags"
                        readonly="1"
                        options="{'no_create': True, 'no_create_edit': True}"
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
