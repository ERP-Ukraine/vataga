<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_equipment_view_form_parameters" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.parameters</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='product_information']" position="after">
                <page string="Параметри" name="parameters">
                    <field name="parameter_ids" nolabel="1">
                        <tree string="Параметри обладнання">
                            <field name="name"/>
                            <field name="description"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
