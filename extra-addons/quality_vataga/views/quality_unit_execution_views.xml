<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workorder_quality_unit_execution" model="ir.ui.view">
        <field name="name">mrp.workorder.quality.unit.execution</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="quality_vataga.mrp_workorder_quality_unit_transfers"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page name="quality_unit_execution" string="Поштучне виконання" groups="mrp.group_mrp_user" invisible="not quality_transfer_controlled">
                    <field name="quality_transfer_controlled" invisible="1"/>
                    <div class="alert alert-info">
                        Обробка лише явно обраних прийнятих QUNIT. Залежності операцій зберігаються.
                        Оброблено — індивідуальне виконання операції; складський випуск і стандартне завершення MO заблоковані.
                    </div>
                    <widget name="quality_unit_execution_buttons"/>
                    <group>
                        <group>
                            <field name="quality_incoming_received_qty" readonly="1"/>
                            <field name="quality_execution_waiting" readonly="1"/>
                            <field name="quality_execution_progress" readonly="1"/>
                        </group>
                        <group>
                            <field name="quality_execution_processed" readonly="1"/>
                            <field name="quality_execution_held" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Приймання та доступність виробів"/>
                    <field name="quality_transfer_in_ids" readonly="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="controlled_unit_id"/>
                            <field name="source_run_id"/>
                            <field name="source_workorder_id"/>
                            <field name="previous_result"/>
                            <field name="admission_id"/>
                            <field name="state"/>
                            <field name="execution_state"/>
                            <field name="execution_reason"/>
                        </tree>
                    </field>
                    <separator string="Історія виконання (включно із зупинками)"/>
                    <field name="quality_execution_ids" readonly="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="controlled_unit_id"/>
                            <field name="source_run_id"/>
                            <field name="state"/>
                            <field name="operator_id"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                            <field name="ended_by_id"/>
                            <field name="result_reference"/>
                            <field name="stop_reason"/>
                            <field name="check_ids" widget="many2many_tags"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="quality_production_unit_execution_history" model="ir.ui.view">
        <field name="name">quality.production.unit.execution.history</field>
        <field name="model">quality.production.unit</field>
        <field name="inherit_id" ref="quality_vataga.quality_production_unit_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page name="quality_execution_history" string="Виконання операцій">
                    <field name="quality_execution_ids" readonly="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="workorder_id"/>
                            <field name="source_run_id"/>
                            <field name="state"/>
                            <field name="operator_id"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                            <field name="result_reference"/>
                            <field name="stop_reason"/>
                            <field name="check_ids" widget="many2many_tags"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
