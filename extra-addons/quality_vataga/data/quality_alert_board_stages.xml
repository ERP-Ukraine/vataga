<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Append a separate board flow after the standard stages. Their names,
         relative order and initial/default stage remain unchanged. -->
    <record id="quality_alert_stage_board_analysis" model="quality.alert.stage">
        <field name="name">Аналіз та обговорення</field>
        <field name="sequence" model="quality.alert.stage"
               eval="max(obj([ref('quality.quality_alert_stage_0'), ref('quality.quality_alert_stage_1'), ref('quality.quality_alert_stage_2'), ref('quality.quality_alert_stage_3')]).mapped('sequence')) + 10"/>
    </record>
    <record id="quality_alert_stage_board_approval" model="quality.alert.stage">
        <field name="name">На затвердженні</field>
        <field name="sequence" model="quality.alert.stage"
               eval="obj(ref('quality_vataga.quality_alert_stage_board_analysis')).sequence + 10"/>
    </record>
    <record id="quality_alert_stage_board_execution" model="quality.alert.stage">
        <field name="name">Виконання рішення</field>
        <field name="sequence" model="quality.alert.stage"
               eval="obj(ref('quality_vataga.quality_alert_stage_board_approval')).sequence + 10"/>
    </record>
</odoo>
