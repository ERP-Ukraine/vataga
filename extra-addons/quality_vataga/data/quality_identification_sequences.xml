<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_quality_production_run" model="ir.sequence">
        <field name="name">Запуски операцій контролю</field>
        <field name="code">quality_vataga.production.run</field>
        <field name="prefix">QRUN/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_quality_production_unit" model="ir.sequence">
        <field name="name">Контрольовані вироби</field>
        <field name="code">quality_vataga.production.unit</field>
        <field name="prefix">QUNIT/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
