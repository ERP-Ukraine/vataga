<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_check_identification_wizard_form" model="ir.ui.view">
        <field name="name">quality.check.identification.wizard.form</field>
        <field name="model">quality.check.identification.wizard</field>
        <field name="arch" type="xml">
            <form string="Ідентифікація виробів">
                <group>
                    <group>
                        <field name="check_id" force_save="1" options="{'no_create': True}"/>
                        <field name="production_id" readonly="1"/>
                        <field name="quantity" readonly="1"/>
                    </group>
                    <group>
                        <field name="mode"/>
                        <field name="run_id" invisible="mode != 'existing'" required="mode == 'existing'"
                               domain="[('production_id', '=', production_id), ('state', '=', 'registered')]"
                               options="{'no_create': True}"/>
                        <field name="workorder_id" invisible="mode == 'existing'"
                               domain="[('production_id', '=', production_id)]" options="{'no_create': True}"/>
                    </group>
                </group>
                <p class="text-muted">
                    Для наступної операції або повторного контролю використовуйте зареєстровані
                    вироби. Номери зразків не визначають відповідність автоматично.
                    Ідентифікація не є допуском до наступної операції.
                </p>
                <p invisible="mode != 'new'" class="text-muted">
                    Кожен рядок зареєструє новий фізичний виріб. Наявні результати зразка
                    збережуться. Реальну партію або серійний номер можна вказати, якщо вони вже існують.
                </p>
                <field name="available_unit_ids" invisible="1"/>
                <field name="product_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="sample_id" column_invisible="True" force_save="1"/>
                        <field name="sample_number" readonly="1"/>
                        <field name="sample_result" readonly="1"/>
                        <field name="controlled_unit_id" column_invisible="parent.mode == 'new'"
                               domain="[('id', 'in', parent.available_unit_ids)]" options="{'no_create': True}"/>
                        <field name="lot_id" column_invisible="parent.mode != 'new'"
                               domain="[('product_id', '=', parent.product_id), ('company_id', 'in', [parent.company_id, False])]"
                               options="{'no_create': True}"/>
                    </tree>
                </field>
                <group><field name="confirm_mapping"/></group>
                <footer>
                    <button name="action_apply" type="object" string="Зафіксувати відповідність" class="btn-primary"/>
                    <button string="Скасувати" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
