<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_unit_release_wizard_form" model="ir.ui.view">
        <field name="name">quality.unit.release.wizard.form</field>
        <field name="model">quality.unit.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Дозволити випуск виробів">
                <group>
                    <field name="production_id" force_save="1"/>
                    <field name="mode" force_save="1"/>
                </group>
                <div class="alert alert-warning">Ця дія підтверджує дозвіл. Готова продукція на склад не надходить; MO та Work Orders не завершуються.</div>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="unit_id" column_invisible="True" force_save="1"/>
                        <field name="permission_id" column_invisible="True" force_save="1"/>
                        <field name="eligible" column_invisible="True"/>
                        <field name="selected" readonly="not eligible"/>
                        <field name="controlled_unit_id"/>
                        <field name="last_workorder_id"/>
                        <field name="execution_done"/>
                        <field name="quality_result"/>
                        <field name="admission_id"/>
                        <field name="readiness"/>
                        <field name="unavailable_reason"/>
                    </tree>
                </field>
                <group invisible="mode != 'cancel'">
                    <field name="reason" required="mode == 'cancel'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Підтвердити" class="btn-primary"/>
                    <button string="Закрити" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
