<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_unit_stock_release_wizard_form" model="ir.ui.view">
        <field name="name">quality.unit.stock.release.wizard.form</field>
        <field name="model">quality.unit.stock.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Випустити дозволені вироби — підготовка">
                <group><field name="production_id" force_save="1"/></group>
                <div class="alert alert-warning"><field name="posting_note" nolabel="1" readonly="1" class="w-100"/></div>
                <div class="alert alert-info">Явно оберіть вироби з чинними дозволами. Перед збереженням плану сервер повторно перевірить допуски, BOM та резерви компонентів. Розрахунок не виконує списання.</div>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="unit_id" force_save="1"/>
                        <field name="eligible" column_invisible="True"/>
                        <field name="selected" readonly="not eligible"/>
                        <field name="check_id"/>
                        <field name="permission_id"/>
                        <field name="admission_id"/>
                        <field name="unavailable_reason"/>
                        <field name="stock_status"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_prepare" type="object" string="Зберегти план без проведення" class="btn-primary"/>
                    <button string="Закрити" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
