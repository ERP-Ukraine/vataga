<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_unit_transfer_wizard_form" model="ir.ui.view">
        <field name="name">quality.unit.transfer.wizard.form</field>
        <field name="model">quality.unit.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Передача / приймання конкретних QUNIT">
                <field name="mode" invisible="1" force_save="1"/>
                <group>
                    <field name="workorder_id" force_save="1"/>
                    <field name="check_id" invisible="mode != 'send'" force_save="1"/>
                    <field name="production_id"/>
                    <field name="destination_workorder_id" invisible="mode != 'send'" required="mode == 'send'"
                           domain="[('production_id', '=', production_id), ('blocked_by_workorder_ids', 'in', [workorder_id])]"
                           options="{'no_create': True}"/>
                </group>
                <div class="alert alert-warning">
                    Це лише реєстрація фізичної передачі / приймання QUNIT. Кількість продукції та партія QC не змінюються.
                    Після першої передачі стандартне виконання Work Orders і складський випуск цього MO будуть заблоковані.
                    Обробка прийнятих QUNIT доступна лише через «Поштучне виконання»; повернення не вимикає захист складського випуску.
                </div>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="sample_id" column_invisible="True" force_save="1"/>
                        <field name="transfer_id" column_invisible="True" force_save="1"/>
                        <field name="eligible" column_invisible="True"/>
                        <field name="selected" readonly="not eligible"/>
                        <field name="controlled_unit_id"/>
                        <field name="sample_number"/>
                        <field name="sample_result"/>
                        <field name="admission_state"/>
                        <field name="transfer_state"/>
                        <field name="unavailable_reason"/>
                    </tree>
                </field>
                <group invisible="mode != 'return'">
                    <field name="reason" required="mode == 'return'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Передати обрані вироби" class="btn-primary" invisible="mode != 'send'"/>
                    <button name="action_apply" type="object" string="Підтвердити приймання" class="btn-primary" invisible="mode != 'receive'"/>
                    <button name="action_apply" type="object" string="Підтвердити повернення" class="btn-primary" invisible="mode != 'return'"/>
                    <button string="Закрити" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
