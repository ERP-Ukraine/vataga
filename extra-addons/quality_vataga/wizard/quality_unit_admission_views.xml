<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_unit_admission_wizard_form" model="ir.ui.view">
        <field name="name">quality.unit.admission.wizard.form</field>
        <field name="model">quality.unit.admission.wizard</field>
        <field name="arch" type="xml">
            <form string="Рішення інспектора про допуск виробів">
                <group>
                    <field name="check_id" force_save="1"/>
                    <field name="mode" force_save="1"/>
                    <field name="operation_run_id"/>
                    <field name="workorder_id"/>
                </group>
                <p class="text-muted">Оберіть конкретні вироби. PASS сам по собі не є допуском. Підтвердження не завершує операцію та не переміщує вироби.</p>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="sample_id" column_invisible="True" force_save="1"/>
                        <field name="eligible" column_invisible="True"/>
                        <field name="selected" readonly="not eligible"/>
                        <field name="controlled_unit_id" options="{'no_create': True}"/>
                        <field name="sample_number"/>
                        <field name="sample_result"/>
                        <field name="admission_state"/>
                        <field name="unavailable_reason"/>
                    </tree>
                </field>
                <group invisible="mode != 'revoke'">
                    <field name="reason" required="mode == 'revoke'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Підтвердити обрані вироби" class="btn-primary" invisible="mode != 'confirm'"/>
                    <button name="action_apply" type="object" string="Скасувати обрані допуски" class="btn-primary" invisible="mode != 'revoke'"/>
                    <button string="Закрити" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="quality_unit_admission_tree" model="ir.ui.view">
        <field name="name">quality.unit.admission.tree</field>
        <field name="model">quality.unit.admission</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="controlled_unit_id"/>
                <field name="check_id"/>
                <field name="operation_run_id"/>
                <field name="workorder_id"/>
                <field name="inspector_id"/>
                <field name="confirmed_at"/>
                <field name="state"/>
                <field name="is_effective"/>
                <field name="ineffective_reason"/>
                <field name="revoked_by_id"/>
                <field name="revoked_at"/>
                <field name="revocation_reason"/>
            </tree>
        </field>
    </record>
    <record id="quality_unit_admission_form" model="ir.ui.view">
        <field name="name">quality.unit.admission.form</field>
        <field name="model">quality.unit.admission</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="controlled_unit_id"/>
                        <field name="check_id"/>
                        <field name="sample_id"/>
                        <field name="operation_run_id"/>
                        <field name="production_id"/>
                        <field name="workorder_id"/>
                        <field name="inspector_id"/>
                        <field name="confirmed_at"/>
                        <field name="state"/>
                        <field name="is_effective"/>
                        <field name="ineffective_reason"/>
                        <field name="revoked_by_id"/>
                        <field name="revoked_at"/>
                        <field name="revocation_reason"/>
                    </group>
                    <field name="required_check_ids" widget="many2many_tags"/>
                    <field name="evidence_snapshot" nolabel="1" class="w-100 text-break"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
