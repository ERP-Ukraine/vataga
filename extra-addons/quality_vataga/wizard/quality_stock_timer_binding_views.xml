<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_timer_binding_wizard_form" model="ir.ui.view">
        <field name="name">quality.stock.timer.binding.wizard.form</field>
        <field name="model">quality.stock.timer.binding.wizard</field>
        <field name="arch" type="xml">
            <form string="Підтвердити склад спільного часу">
                <div class="alert alert-warning">Оберіть лише вироби, які фактично оброблялись у цьому інтервалі. Політика передбачає рівні частки серед підтверджених учасників. Підтвердження незмінне та не вмикає складське проведення. Затрати працівників очікують Enterprise-перевірки.</div>
                <group>
                    <field name="production_id"/>
                    <field name="timer_id" domain="[('workorder_id.production_id', '=', production_id), ('date_end', '!=', False), ('quality_execution_batch_id', '=', False)]" options="{'no_create': True}"/>
                    <field name="unit_ids" widget="many2many_tags" domain="[('production_id', '=', production_id)]" options="{'no_create': True}"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_apply" string="Підтвердити склад" type="object" class="btn-primary"/>
                    <button string="Закрити" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
