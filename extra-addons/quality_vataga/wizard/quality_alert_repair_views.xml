<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_alert_repair_wizard_form" model="ir.ui.view">
        <field name="name">quality.alert.repair.wizard.form</field>
        <field name="model">quality.alert.repair.wizard</field>
        <field name="arch" type="xml">
            <form string="Підтвердити доопрацювання">
                <group>
                    <field name="alert_id" options="{'no_create': True}"/>
                </group>
                <p>Підтвердіть фактичне виконання ремонту всіх зазначених виробів. Далі необхідний окремий повторний контроль.</p>
                <field name="sample_ids" readonly="1" nolabel="1">
                    <tree create="0" edit="0" delete="0">
                        <field name="controlled_unit_id"/>
                        <field name="sample_number"/>
                        <field name="sample_result"/>
                    </tree>
                </field>
                <group col="2" class="w-100">
                    <field name="note" nolabel="1" colspan="2" class="w-100" placeholder="Опишіть виконані роботи для зазначених QUNIT"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Підтвердити виконання" class="btn-primary"/>
                    <button string="Закрити" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
