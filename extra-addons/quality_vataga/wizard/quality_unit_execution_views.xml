<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_unit_execution_wizard_form" model="ir.ui.view">
        <field name="name">quality.unit.execution.wizard.form</field>
        <field name="model">quality.unit.execution.wizard</field>
        <field name="arch" type="xml">
            <form string="Поштучне виконання">
                <group>
                    <field name="workorder_id" options="{'no_open': True}" force_save="1"/>
                    <field name="mode" force_save="1"/>
                    <field name="point_id" invisible="mode != 'control'" required="mode == 'control'"/>
                </group>
                <div class="alert alert-info">Оберіть конкретні вироби. Таймер сам по собі не підтверджує виконання або якість. Проміжний прогрес не змінює кількості MO і не створює складських рухів.</div>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="transfer_id" column_invisible="True" force_save="1"/>
                        <field name="execution_id" column_invisible="True" force_save="1"/>
                        <field name="eligible" column_invisible="True"/>
                        <field name="selected" readonly="not eligible"/>
                        <field name="controlled_unit_id"/>
                        <field name="status"/>
                        <field name="unavailable_reason"/>
                    </tree>
                </field>
                <group invisible="mode not in ('finish', 'stop')">
                    <field name="reference" required="mode in ('finish', 'stop')"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Підтвердити обрані вироби" class="btn-primary"/>
                    <button string="Закрити" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
