<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_execution_company_rule" model="ir.rule">
        <field name="name">Виконання QUNIT: дозволені компанії</field>
        <field name="model_id" ref="model_quality_unit_execution"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="quality_execution_batch_company_rule" model="ir.rule">
        <field name="name">Робочі інтервали QUNIT: дозволені компанії</field>
        <field name="model_id" ref="model_quality_unit_execution_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
