<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_release_batch_company_rule" model="ir.rule">
        <field name="name">Пакети дозволу: дозволені компанії</field>
        <field name="model_id" ref="model_quality_unit_release_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="quality_release_line_company_rule" model="ir.rule">
        <field name="name">Дозволи випуску: дозволені компанії</field>
        <field name="model_id" ref="model_quality_unit_release_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="quality_release_event_company_rule" model="ir.rule">
        <field name="name">Події дозволу: дозволені компанії</field>
        <field name="model_id" ref="model_quality_unit_release_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
