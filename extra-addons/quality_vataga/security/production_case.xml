    <field name="model_id" search="[('model', '=', 'quality.alert')]"/>
    <field name="domain_force">[(1, '=', 1)] if (user._production_case_legacy_access('quality.alert', 'read')) or not (user.has_group('quality_vataga.group_quality_production_master') or user.has_group('quality_vataga.group_quality_production_executor')) else [('production_case_mo_id', '!=', False), ('company_id', 'in', company_ids), '|', ('production_master_id', '=', user.id), ('production_executor_id', '=', user.id)]</field>
    <field name="perm_read">1</field>
    <field name="perm_write">0</field>
    <field name="perm_create">0</field>
    <field name="perm_unlink">0</field>
  </record>
