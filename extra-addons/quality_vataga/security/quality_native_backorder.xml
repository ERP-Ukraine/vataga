    <record id="quality_unit_stock_fact_company_rule" model="ir.rule">
        <field name="name">Фактичний випуск QUNIT: дозволені компанії</field>
        <field name="model_id" ref="model_quality_unit_stock_fact"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
