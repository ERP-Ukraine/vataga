<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="quality_vataga.ShopFloorQuantityDialog">
        <Dialog title="title">
            <label class="form-label" for="quality_shop_floor_quantity">Фактична кількість</label>
            <input id="quality_shop_floor_quantity" type="number" min="1" step="1" class="form-control mb-3"
                   t-att-max="props.production.data.product_qty" t-model="state.quantity"/>
            <t t-if="props.production.data.product_tracking !== 'none'">
                <label class="form-label" for="quality_shop_floor_lot">Партія/серійний номер</label>
                <Many2XAutocomplete t-props="lotField"/>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="!canRegister || state.saving" t-on-click="register">Зареєструвати</button>
                <button class="btn btn-secondary" t-att-disabled="state.saving" t-on-click="props.close">Скасувати</button>
            </t>
        </Dialog>
    </t>
</templates>
